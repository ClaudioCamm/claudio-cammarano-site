diff --git a/src/css/style.css b/src/css/style.css
index efc0a2e..caefd36 100644
--- a/src/css/style.css
+++ b/src/css/style.css
@@ -443,6 +443,69 @@ main {
   border-bottom: none;
 }
 
+/* === START HERE (homepage) === */
+.start-here {
+  display: grid;
+  grid-template-columns: 1fr 1.7fr;
+  gap: var(--spacing-md);
+  background: var(--color-bg-alt);
+  border: 1px solid var(--color-border);
+  border-radius: 4px;
+  padding: var(--spacing-md);
+  margin-bottom: var(--spacing-lg);
+}
+
+.start-here-question {
+  font-family: var(--font-serif);
+  font-size: 1.05rem;
+  font-weight: 600;
+  color: var(--color-text);
+  margin: 0 0 6px;
+}
+
+.start-here-note {
+  font-size: 0.88rem;
+  color: var(--color-text-light);
+  margin: 0 0 10px;
+}
+
+.start-here-link {
+  font-size: 0.9rem;
+}
+
+.start-here-list {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+
+.start-here-item {
+  margin-bottom: 12px;
+}
+
+.start-here-item:last-child {
+  margin-bottom: 0;
+}
+
+.start-here-item a {
+  font-family: var(--font-serif);
+  font-weight: 500;
+}
+
+.start-here-context {
+  display: block;
+  font-size: 0.85rem;
+  color: var(--color-text-light);
+  margin-top: 2px;
+}
+
+@media (max-width: 700px) {
+  .start-here {
+    grid-template-columns: 1fr;
+    gap: var(--spacing-sm);
+  }
+}
+
 .article-meta {
   display: flex;
   gap: 6px;
