---
pagination:
  data: collections.tagList
  size: 1
  alias: tag
permalink: "/tag/{{ tag | slugify }}/"
layout: layouts/base.njk
eleventyComputed:
  title: "{{ tag }}"
  description: "Tutti gli articoli su {{ tag }}"
---

{% set tagPosts = collections.writings | filterByTag(tag) %}

<div class="tag-page">
  <header class="tag-page-header">
    <p class="tag-page-label">Argomento</p>
    <h1 class="tag-page-title">{{ tag }}</h1>
    <p class="tag-page-count">{{ tagPosts.length }} {% if tagPosts.length == 1 %}articolo{% else %}articoli{% endif %}</p>
  </header>

  <div class="tag-page-posts">
    {% for post in tagPosts %}
    <article class="article-card article-card--secondary">
      {% if post.data.series %}<div class="article-series-card-label">{{ post.data.series }}</div>{% endif %}
      <div class="article-meta">
        <span class="article-date">{{ post.date | formatDate }}</span>
        {% if post.data.category %}
          {% if post.data.category.length %}
            {% for cat in post.data.category %}<a class="article-tag" href="/tag/{{ cat | slugify }}/">{{ cat }}</a>{% endfor %}
          {% else %}
            <a class="article-tag" href="/tag/{{ post.data.category | slugify }}/">{{ post.data.category }}</a>
          {% endif %}
        {% endif %}
        {% if post.templateContent %}<span class="reading-time">{{ post.templateContent | readingTime }}</span>{% endif %}
      </div>
      <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
      {% if post.data.description %}<p class="article-card-subtitle">{{ post.data.description }}</p>{% endif %}
    </article>
    {% endfor %}
  </div>
</div>
