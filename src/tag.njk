---
pagination:
  data: collections.tagList
  size: 1
  alias: tag
permalink: "/tag/{{ tag | slugify }}/"
layout: layouts/base.njk
eleventyComputed:
  title: "{{ tag }}"
  description: "{% if tagDescriptions[tag] %}{{ tagDescriptions[tag] | truncate(155) }}{% else %}Tutti gli articoli su {{ tag }}{% endif %}"
---

{% set tagPosts = collections.allPosts | filterByTag(tag) %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "{{ tag | jsonEscape | safe }}",
  "description": "{% if tagDescriptions[tag] %}{{ tagDescriptions[tag] | truncate(200) | jsonEscape | safe }}{% else %}Tutti gli articoli di Claudio Cammarano su {{ tag | jsonEscape | safe }}{% endif %}",
  "url": "https://claudiocammarano.com/tag/{{ tag | slugify }}/",
  "author": {
    "@type": "Person",
    "name": "Claudio Cammarano",
    "url": "https://claudiocammarano.com/about/"
  },
  "hasPart": [
    {% for post in tagPosts %}
    {
      "@type": "BlogPosting",
      "headline": "{{ post.data.title | jsonEscape | safe }}",
      "url": "https://claudiocammarano.com{{ post.url }}",
      "datePublished": "{{ post.date | isoDate }}"{% if post.data.description %},
      "description": "{{ post.data.description | stripMd | jsonEscape | safe }}"{% endif %}
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>

<div class="tag-page">
  <header class="tag-page-header">
    {% set tagCluster = tag | clusterOf %}
    {% if tagCluster %}
    <p class="tag-page-cluster"><a href="/temi/#{{ tagCluster | slugify }}">{{ tagCluster }}</a></p>
    {% endif %}
    <p class="tag-page-label">Argomento</p>
    <h1 class="tag-page-title">{{ tag }}</h1>
    <p class="tag-page-count">{{ tagPosts.length }} {% if tagPosts.length == 1 %}articolo{% else %}articoli{% endif %}</p>
    {% if tagDescriptions[tag] %}
    <p class="tag-page-intro">{{ tagDescriptions[tag] }}</p>
    {% endif %}
  </header>

  {% set spark = tagPosts | dateSparkline %}
  {% if spark.points.length %}
  <div class="tag-sparkline" aria-label="Distribuzione temporale degli articoli">
    <svg viewBox="0 0 100 16" preserveAspectRatio="none" class="tag-sparkline-svg" aria-hidden="true">
      <line x1="2" y1="10" x2="98" y2="10" class="tag-sparkline-axis"></line>
      {% for pt in spark.points %}
      <circle cx="{{ pt.x }}" cy="10" r="2.4" class="tag-sparkline-dot">
        <title>{{ pt.title }} — {{ pt.dateLabel }}</title>
      </circle>
      {% endfor %}
    </svg>
    <div class="tag-sparkline-labels">
      <span>{{ spark.minLabel }}</span>
      {% if not spark.single %}<span>{{ spark.maxLabel }}</span>{% endif %}
    </div>
  </div>
  {% endif %}

  {% set related = tag | relatedArgomenti(collections.allPosts) %}
  {% if related.length %}
  <section class="tag-related" aria-label="Argomenti collegati">
    <p class="tag-related-label">Argomenti vicini</p>
    <div class="tag-related-pills">
      {% for r in related %}
      <a href="/tag/{{ r.name | slugify }}/" class="temi-tag-pill" title="{{ r.count }} {% if r.count == 1 %}articolo in comune{% else %}articoli in comune{% endif %}">{{ r.name }}<span class="temi-tag-count">{{ r.count }}</span></a>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <div class="tag-page-posts">
    {% for post in tagPosts %}
      {% if post.data._postType != "curated" %}
      <article class="article-card article-card--secondary">
        {% if post.data.series %}<div class="article-series-card-label"><a href="/serie/{{ post.data.series | seriesBaseName | slugify }}/">{{ post.data.series }}</a></div>{% endif %}
        <div class="article-meta">
          <span class="article-date">{{ post.date | formatDate }}</span>
          {% if post.data.category %}
            {% if post.data.category.length %}
              {% for cat in post.data.category %}<a class="article-tag" href="/tag/{{ cat | slugify }}/">{{ cat }}</a>{% endfor %}
            {% else %}
              <a class="article-tag" href="/tag/{{ post.data.category | slugify }}/">{{ post.data.category }}</a>
            {% endif %}
          {% endif %}
          {% if post.templateContent %}<span class="reading-time">{{ post.templateContent | readingTime }}</span>{% endif %}
        </div>
        <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
        {% if post.data.description %}<p class="article-card-subtitle">{{ post.data.description | mdInline | safe }}</p>{% endif %}
      </article>
      {% endif %}
    {% endfor %}
    {% for post in tagPosts %}
      {% if post.data._postType == "curated" %}
      <article class="article-card article-card--curated">
        <div class="article-meta">
          <span class="article-date">{{ post.date | formatDate }}</span>
          <span class="curated-badge">Curated</span>
          {% if post.data.source %}<span class="curated-source-label">· {{ post.data.source }}</span>{% endif %}
          {% if post.data.tags %}
            {% for t in post.data.tags %}{% if t != 'curated' %}{% set canonical = curatedTagAliases[t | lower] %}{% if canonical %}<a class="article-tag" href="/tag/{{ canonical | slugify }}/">{{ canonical }}</a>{% endif %}{% endif %}{% endfor %}
          {% endif %}
        </div>
        <h2><a href="{{ post.data.external_url }}" target="_blank" rel="noopener">{{ post.data.title }} ↗</a></h2>
        {% if post.data.description %}<p class="article-card-subtitle">{{ post.data.description | mdInline | safe }}</p>{% endif %}
        {% if post.data.concepts and post.data.concepts.length %}
        <div class="concetto-chips curated-concepts">
          {% for cname in post.data.concepts %}
          <a href="/concetti/{{ cname | slugify }}/" class="concetto-chip">{{ cname }}</a>
          {% endfor %}
        </div>
        {% endif %}
      </article>
      {% endif %}
    {% endfor %}
  </div>

  <div class="temi-footer-nav">
    <p>Esplora concetti, persone e testi citati in questi articoli → <a href="/indice/">Indice analitico</a>.</p>
  </div>
</div>
