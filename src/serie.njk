---
pagination:
  data: collections.seriesList
  size: 1
  alias: serie
permalink: "/serie/{{ serie | slugify }}/"
layout: layouts/base.njk
eleventyComputed:
  title: "{{ serie }}"
  description: "Tutti gli articoli della serie {{ serie }}"
---

{% set seriePosts = collections.writings | filterBySeries(serie) %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "{{ serie | jsonEscape | safe }}",
  "description": "Serie di articoli di Claudio Cammarano: {{ serie | jsonEscape | safe }}",
  "url": "https://claudiocammarano.com/serie/{{ serie | slugify }}/",
  "author": {
    "@type": "Person",
    "name": "Claudio Cammarano",
    "url": "https://claudiocammarano.com/about/"
  },
  "hasPart": [
    {% for post in seriePosts %}
    {
      "@type": "BlogPosting",
      "headline": "{{ post.data.title | jsonEscape | safe }}",
      "url": "https://claudiocammarano.com{{ post.url }}",
      "datePublished": "{{ post.date | isoDate }}"{% if post.data.description %},
      "description": "{{ post.data.description | jsonEscape | safe }}"{% endif %}
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>

<div class="tag-page">
  <header class="tag-page-header">
    <p class="tag-page-label">Serie</p>
    <h1 class="tag-page-title">{{ serie }}</h1>
    <p class="tag-page-count">{{ seriePosts.length }} {% if seriePosts.length == 1 %}articolo{% else %}articoli{% endif %}</p>
    {% if seriesDescriptions[serie] %}
    <p class="tag-page-intro">{{ seriesDescriptions[serie] }}</p>
    {% endif %}
  </header>

  <div class="tag-page-posts">
    {% for post in seriePosts %}
    <article class="article-card article-card--secondary">
      <div class="article-series-card-label"><a href="/serie/{{ post.data.series | seriesBaseName | slugify }}/">{{ post.data.series }}</a></div>
      <div class="article-meta">
        <span class="article-date">{{ post.date | formatDate }}</span>
        {% if post.data.category %}
          {% if post.data.category.length %}
            {% for cat in post.data.category %}<a class="article-tag" href="/tag/{{ cat | slugify }}/">{{ cat }}</a>{% endfor %}
          {% else %}
            <a class="article-tag" href="/tag/{{ post.data.category | slugify }}/">{{ post.data.category }}</a>
          {% endif %}
        {% endif %}
        {% if post.templateContent %}<span class="reading-time">{{ post.templateContent | readingTime }}</span>{% endif %}
      </div>
      <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
      {% if post.data.description %}<p class="article-card-subtitle">{{ post.data.description }}</p>{% endif %}
    </article>
    {% endfor %}
  </div>
</div>
