---
permalink: /episteme-advisory/lab/feed.xml
layout: false
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>Claudio Cammarano — Lab</title>
    <link>https://claudiocammarano.com/episteme-advisory/lab/</link>
    <description>Dated, in-progress research notes on epistemology, AI validation and ontological taxonomy — the open work behind the published essays.</description>
    <language>en</language>
    <atom:link href="https://claudiocammarano.com/episteme-advisory/lab/feed.xml" rel="self" type="application/rss+xml"/>
    {% for note in collections.lab %}
    <item>
      <title>{{ note.data.title | jsonEscape }}</title>
      <link>https://claudiocammarano.com{{ note.url }}</link>
      <guid isPermaLink="true">https://claudiocammarano.com{{ note.url }}</guid>
      <pubDate>{{ note.date | rssDate }}</pubDate>
      {% if note.data.description %}<description>{{ note.data.description | stripMd | jsonEscape }}</description>{% endif %}
    </item>
    {% endfor %}
  </channel>
</rss>
