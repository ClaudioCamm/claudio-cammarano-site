@article{chang2024language,
  author = {Chang, Tyler A. and Bergen, Benjamin K.},
  title = {Language Model Behavior: A Comprehensive Survey},
  journal = {Computational Linguistics},
  volume = {50},
  number = {1},
  year = {2024},
  url = {https://arxiv.org/abs/2303.11504},
  note = {Survey su oltre 250 studi sul comportamento degli LLM prima del fine-tuning. Documenta capacità in sintassi, semantica, pragmatica, world knowledge e ragionamento, con sensibilità agli input specifici. Rilevante per inquadrare il progetto nella letteratura su LLM come strumenti di ricerca linguistica. Mostra che la pragmatica rimane il dominio più fragile, il che motiva la necessità di framework ontologici come il nostro.}
}

@article{yu2024assessing,
  author = {Yu, Danni and Li, Luyang and Su, Hang and Fuoli, Matteo},
  title = {Assessing the potential of {LLM}-assisted annotation for corpus-based pragmatics and discourse analysis: The case of apology},
  journal = {International Journal of Corpus Linguistics},
  volume = {29},
  number = {4},
  pages = {534--561},
  year = {2024},
  doi = {10.1075/ijcl.23087.yu},
  note = {Confronto GPT-3.5, GPT-4 e annotatore umano su annotazione di componenti delle scuse in inglese. GPT-4 raggiunge accuratezza prossima all'umano; GPT-3.5 significativamente inferiore. Struttura analitica analoga al presente progetto: LLM come co-annotatore su fenomeni pragmatici complessi, con validazione umana. Direttamente citabile in sez. 4 (metodologia) e sez. 7 (lavoro futuro: estensione a corpora annotati). Prima fonte specifica su LLM e annotazione pragmatica in corpus linguistics.}
}

@article{ziems2024llms,
  author = {Ziems, Caleb and Held, William and Shaikh, Omar and Chen, Jiaao and Zhang, Zhehao and Yang, Diyi},
  title = {Can Large Language Models Transform Computational Social Science?},
  journal = {Computational Linguistics},
  volume = {50},
  number = {1},
  pages = {237--291},
  year = {2024},
  doi = {10.1162/coli_a_00502},
  note = {Valutazione zero-shot di 13 LLM su 25 benchmark di computational social science. Risultato chiave: su task di classificazione tassonomica gli LLM non superano i modelli fine-tuned, ma su task di codifica a forma libera producono spiegazioni che spesso eccedono la qualità dei crowdworker. Tensione rilevante per il nostro design: la classificazione D1 è esattamente il tipo di task in cui gli LLM sono più fragili; la sintesi estesa è il tipo di task in cui eccellono. Citare in sez. 4.5 (limiti metodologici) e sez. 6.4 (implicazioni).}
}

