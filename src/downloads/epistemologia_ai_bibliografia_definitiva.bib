% ============================================
% PEIRCE: ABDUZIONE E SEMIOTICA
% (Aggiunta v3 — Febbraio 2026)
% Contesto: fondamento filosofico del metodo generativo del framework.
% L'abduzione (retroduction) spiega come le categorie della tassonomia
% emergono dall'analisi dei casi limite, non sono dedotte a priori.
% La semiotica peirciana (icone/indice/simbolo) anticipa strutturalmente
% la precedenza di D1 sulle dimensioni attributive D2-D7.
% Citare in sez. 3.1 (fondamenti filosofici) come anello mancante tra
% Popper/Lakatos (test delle ipotesi) e la generazione delle ipotesi stesse.
% ============================================

@book{peirce1931collected,
  author = {Peirce, Charles Sanders},
  title = {Collected Papers of Charles Sanders Peirce},
  publisher = {Harvard University Press},
  year = {1931--1958},
  address = {Cambridge, MA},
  editor = {Hartshorne, Charles and Weiss, Paul and Burks, Arthur W.},
  volume = {1--8},
  note = {Lettura selettiva. Vol. 2, §2.619--2.644: teoria dei segni (icone, indice, simbolo) --- fondamento semiotico della precedenza categoriale D1. Vol. 5, §5.171--5.212: abduzione come terza forma di inferenza, distinta da deduzione e induzione --- il momento creativo del metodo scientifico. Vol. 5, §5.180: "The surprising fact C is observed; but if A were true, C would be a matter of course; hence, there is reason to suspect that A is true" --- struttura canonica dell'abduzione. Essenziale per la sez. 3.1 come fondamento del metodo generativo del framework.}
}

@book{peirce1903harvard,
  author = {Peirce, Charles Sanders},
  title = {Harvard Lectures on Pragmatism},
  publisher = {Harvard University},
  year = {1903},
  address = {Cambridge, MA},
  note = {Ripubblicato in Collected Papers vol. 5, §5.14--5.212. Lezioni VII e VIII: Abduzione come "the only logical operation which introduces any new idea" --- distinzione fondamentale tra retroduction (generazione ipotesi) e deduzione/induzione (test). Rilevante per distinguere la fase generativa del framework (claim di frontiera come sonde abduttive) dalla fase di test (le 90 validazioni, il κ di Fleiss). La struttura lakatosiana del progetto --- nucleo duro stabile + cintura protettiva in espansione --- è coerente con il ciclo peirciano abduzione → deduzione → induzione.}
}

@book{fann1970peirce,
  author = {Fann, Kuang Tih},
  title = {Peirce's Theory of Abduction},
  publisher = {Martinus Nijhoff},
  year = {1970},
  address = {The Hague},
  note = {Monografia dedicata all'abduzione peirciana. Cap. 2: distinzione abduzione/induzione nella fase matura di Peirce (post-1900). Cap. 4: abduzione e scoperta scientifica --- il problema della generazione vs. giustificazione delle ipotesi. Testo secondario consigliato per contestualizzare Peirce nella letteratura filosofica contemporanea senza dover leggere tutti i Collected Papers. Utile per rispondere a potenziali obiezioni di un reviewer sulla vaghezza del concetto di abduzione.}
}

