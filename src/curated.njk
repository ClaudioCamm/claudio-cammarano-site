---
layout: layouts/base.njk
title: Curated
---

<h1>Curated</h1>
<p>Link esterni curati e selezionati su media, marketing e content industries.</p>

{% for item in collections.curated %}
<article class="article-card article-card--curated">
    <div class="article-meta">
        <span class="article-date">{{ item.data.date | formatDate }}</span>
        {% if item.data.source %}
        <span class="curated-source-label">· {{ item.data.source }}</span>
        {% endif %}
    </div>
    <h2><a href="{{ item.data.external_url }}" target="_blank">{{ item.data.title }} ↗</a></h2>
    {% if item.data.description %}
    <p>{{ item.data.description }}</p>
    {% endif %}
</article>
{% endfor %}
