{# Gli stili della specifica ENTIA, condivisi fra /entia/ (italiano) e
   /en/entia/ (specifica normativa inglese). Stavano inline nella pagina
   italiana: estratti qui il 18/10 perche' due pagine li usano e una copia
   per pagina avrebbe cominciato a divergere al primo ritocco. #}
<style>
.entia-tab{width:100%;overflow-x:auto}
.entia-tab table{border-collapse:collapse;width:100%;min-width:560px;font-size:.92em}
.entia-tab th,.entia-tab td{text-align:left;padding:.55em .9em .55em 0;border-bottom:1px solid var(--color-border);vertical-align:top}
.entia-tab th{font-size:.72em;letter-spacing:.08em;text-transform:uppercase;color:var(--color-text-light)}
.entia-tab td.n{text-align:right;padding-right:0;font-variant-numeric:tabular-nums}
.entia-fn{margin:0 0 1.6em;padding-left:1em;border-left:3px solid var(--color-primary)}
.entia-fn h3{margin:0 0 .2em;font-size:1.05em}
.entia-fn .ord{font-size:.72em;letter-spacing:.08em;text-transform:uppercase;color:var(--color-text-light)}
.entia-fn .prova{font-style:italic;margin:.4em 0 .3em}
.entia-regola{margin:0 0 1.1em}
.entia-regola b{display:block}
.entia-grad text{font-family:inherit}
.entia-nota{font-size:.9em;color:var(--color-text-light)}

/* --- mappa a strati: tinte categoriali dei cinque temi, validate per
   separazione in daltonismo e contrasto in chiaro e in scuro --- */
:root{--e0:#4C7FE0;--e1:#C0304A;--e2:#009E73;--e3:#9A35A8;--e4:#C9A227}
@media (prefers-color-scheme: dark){
  :root{--e0:#5A89E6;--e1:#CC3A54;--e2:#0CA87C;--e3:#A840B6;--e4:#AE8C28}
}
.entia-mappa{margin:1.4em 0 0}
.em-barra{display:flex;flex-wrap:wrap;gap:.6em 1.4em;align-items:flex-end;margin:0 0 .8em}
.em-gruppo{display:flex;flex-direction:column;gap:.3em}
.em-etich{font-size:.66em;letter-spacing:.1em;text-transform:uppercase;color:var(--color-text-light)}
.em-pill{display:flex;flex-wrap:wrap;gap:2px;background:var(--color-bg-alt);padding:3px;border-radius:7px}
.em-pill button{font:inherit;font-size:.82em;border:0;background:transparent;color:var(--color-text-light);
  padding:.3em .7em;border-radius:5px;cursor:pointer;white-space:nowrap}
.em-pill button[aria-pressed="true"]{background:var(--color-bg);color:var(--color-text);font-weight:600}
.em-briciole{display:flex;flex-wrap:wrap;align-items:center;gap:.3em;font-size:.86em;min-height:1.7em;margin:0 0 .4em}
.em-briciole button{font:inherit;border:0;background:transparent;color:var(--color-primary);cursor:pointer;
  padding:.1em .2em;text-decoration:underline;text-underline-offset:2px}
.em-briciole .sep{color:var(--color-text-light)}
.em-briciole .qui{font-weight:600}
.em-livello{font-size:.66em;letter-spacing:.1em;text-transform:uppercase;color:var(--color-text-light);margin-left:auto}
#em-tela{position:relative;width:100%;height:clamp(360px,58vh,560px);border:1px solid var(--color-border);
  border-radius:8px;overflow:hidden;background:var(--color-bg-alt)}
.em-tess{position:absolute;overflow:hidden;cursor:pointer;border-radius:3px;outline:2px solid transparent;
  transition:filter .12s ease,outline-color .12s ease}
.em-tess:hover,.em-tess:focus-visible{filter:brightness(1.07);outline-color:var(--color-text);z-index:3}
.em-tess.foglia{cursor:default}
.em-nome{position:absolute;left:6px;top:4px;right:6px;font-size:.74em;font-weight:600;line-height:1.2;
  color:#fff;text-shadow:0 1px 2px rgba(0,0,0,.45);pointer-events:none;overflow:hidden}
.em-nome .q{display:block;font-weight:400;font-size:.9em;opacity:.88;margin-top:1px;font-variant-numeric:tabular-nums}
.em-sotto{position:absolute;border-radius:2px;pointer-events:none;background:rgba(255,255,255,.17);
  border:1px solid rgba(255,255,255,.3)}
.em-vuoto{display:flex;align-items:center;justify-content:center;height:100%;color:var(--color-text-light);
  font-size:.95em;padding:1.2em;text-align:center}
.em-legenda{display:flex;flex-wrap:wrap;gap:.3em 1em;margin:.6em 0 0;font-size:.8em;color:var(--color-text-light)}
.em-legenda .voce{display:flex;align-items:center;gap:.4em}
.em-legenda .chip{width:11px;height:11px;border-radius:3px;flex:none}
#em-lettura{margin:.9em 0 0;padding:.8em 1em;border:1px solid var(--color-border);border-radius:8px;min-height:5em}
#em-lettura h3{margin:0 0 .2em;font-size:1.02em}
#em-lettura .meta{font-size:.78em;color:var(--color-text-light);display:flex;flex-wrap:wrap;gap:.2em .9em;
  font-variant-numeric:tabular-nums}
#em-lettura .corpo{font-size:.92em;margin:.5em 0 0;color:var(--color-text-light)}
.em-tabella{margin:.8em 0 0}
.em-tabella summary{font-size:.85em;color:var(--color-text-light);cursor:pointer}
@media (prefers-reduced-motion: reduce){.em-tess{transition:none}}
.entia-scaduto{border-left:3px solid var(--color-irene,#800020);padding:.5em 0 .5em .9em;font-size:.9em;color:var(--color-text-light);margin:.8em 0 0}
.entia-citazione{border-left:3px solid var(--color-primary);padding-left:.9em;margin:1.2em 0;font-size:.95em}
</style>
