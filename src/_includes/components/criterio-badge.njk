{#
  Badge del criterio + glossa per le schede curated.
  Uso: impostare criterioSlug (e opzionalmente criterioPerche) prima dell'include.
  Fallback totale: se lo slug manca o non è nella lista _data/criteri.json,
  non renderizza nulla — la scheda resta identica a prima.
#}
{% if criterioSlug and criteri[criterioSlug] %}
<p class="curated-criterio"><span class="criterio-badge">{{ criteri[criterioSlug].label }}</span>{% if criterioPerche %} <span class="criterio-perche">{{ criterioPerche | mdInline | safe }}</span>{% endif %}</p>
{% endif %}
{% set criterioSlug = null %}
{% set criterioPerche = null %}
