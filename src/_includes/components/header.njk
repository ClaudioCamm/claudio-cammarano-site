<header class="site-header">
    <div class="header-top">
        <div class="container header-top-inner">
            <a href="/" class="header-name">Claudio Cammarano</a>
            <span class="header-tagline">Libri, mercati, idee</span>
            <a href="/search/" class="header-search" aria-label="Cerca" title="Cerca">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            </a>
            <button class="nav-toggle" id="nav-toggle" aria-label="Apri menu" aria-expanded="false" aria-controls="site-nav">
                <span class="nav-toggle-bar"></span>
                <span class="nav-toggle-bar"></span>
                <span class="nav-toggle-bar"></span>
            </button>
        </div>
    </div>
    <nav class="site-nav" id="site-nav">
        <div class="container">
            <ul>
                <li><a href="/"{% if page.url == "/" %} class="active"{% endif %}>Home</a></li>
                <li><a href="/writings/"{% if page.url == "/writings/" %} class="active"{% endif %}>Writings</a></li>
                <li><a href="/curated/"{% if page.url == "/curated/" %} class="active"{% endif %}>Curated</a></li>
                <li><a href="/learning/"{% if page.url == "/learning/" %} class="active"{% endif %}>Learning log</a></li>
                <li><a href="/irene-media/"{% if page.url == "/irene-media/" %} class="active"{% endif %}>Irene Media</a></li>
                <li><a href="/episteme-advisory/"{% if page.url == "/episteme-advisory/" %} class="active"{% endif %}>Episteme Advisory <span class="nav-badge nav-badge--new">new</span></a></li>
                <li><a href="/about/"{% if page.url == "/about/" %} class="active"{% endif %}>About</a></li>
                <li><a href="/newsletter/"{% if page.url == "/newsletter/" %} class="active"{% endif %}>The Abstract</a></li>
                <li class="nav-search-item" style="display:none"><a href="/search/">Cerca</a></li>
            </ul>
        </div>
    </nav>
</header>

<script>
(function() {
  var toggle = document.getElementById('nav-toggle');
  var nav = document.getElementById('site-nav');
  if (!toggle || !nav) return;
  toggle.addEventListener('click', function() {
    var open = nav.classList.toggle('nav-open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    toggle.classList.toggle('is-open', open);
  });
  document.addEventListener('click', function(e) {
    if (!toggle.contains(e.target) && !nav.contains(e.target)) {
      nav.classList.remove('nav-open');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.classList.remove('is-open');
    }
  });
})();
</script>
