{# righello delle sottolineature: "rz" e' un elemento di work.rulerZones / extract.rulers #}
<div class="ru-z">{% for z in rz.zones %}{% if not loop.first %}<div class="ru-gap" aria-hidden="true">⁄⁄</div>{% endif %}<div style="--n:{{ z.n }}"><div class="ru-b" style="grid-template-columns:repeat({{ z.n }},1fr)">{% for p in z.pages %}<span><em>{{ p }}</em></span>{% endfor %}{% for m in z.marks %}<i class="{{ 'r' if m.role == 'structure' else ('g' if m.role == 'definition' else 'y') }}" style="left:calc({{ m.left }}% + {{ 4 + m.k * 8 }}px)"></i>{% endfor %}</div><p>pp. {{ z.a }}–{{ z.b }} · {{ z.marks.length }} marks</p></div>{% endfor %}</div>
