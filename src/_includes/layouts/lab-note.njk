---
layout: layouts/base.njk
og_type: article
lang: en
---

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "{{ title | jsonEscape | safe }}",
  "description": "{{ description | stripMd | jsonEscape | safe }}",
  "datePublished": "{{ date | isoDate }}",
  "inLanguage": "en",
  "url": "https://claudiocammarano.com{{ page.url }}",
  "author": {
    "@type": "Person",
    "@id": "https://claudiocammarano.com/#person",
    "name": "Claudio Cammarano",
    "url": "https://claudiocammarano.com/about/"
  },
  "isPartOf": { "@id": "https://claudiocammarano.com/#website" }{% if discipline or method %},
  "about": [{% if discipline %}{% for d in discipline %}{"@type":"Thing","name":"{{ d | jsonEscape | safe }}"}{% if not loop.last %},{% endif %}{% endfor %}{% endif %}],
  "keywords": "{% if method %}{{ method | join(', ') | jsonEscape | safe }}{% endif %}"{% endif %}
}
</script>

<article class="article-full article-full--lab">
  <header class="article-header">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/en/">The programme</a>
      <span class="breadcrumb-sep" aria-hidden="true">·</span>
      <a href="/lab/">Lab</a>
      <span class="breadcrumb-sep" aria-hidden="true">·</span>
      <span class="breadcrumb-current">{{ title }}</span>
    </nav>
    <div class="article-meta">
      <span class="article-date">{{ date | formatDateEN }}</span>
      {% if project %}<span class="article-tag">{{ project }}</span>{% endif %}
      {% if stage %}<span class="article-tag">{{ stage }}</span>{% endif %}
      {% if content %}<span class="reading-time">{{ content | readingTime }}</span>{% endif %}
    </div>
    <h1>{{ title }}</h1>
    {% if description %}
    <p class="article-description">{{ description }}</p>
    {% endif %}
  </header>

  <div class="article-body">
    {{ content | safe }}
    {% set aiLangKey = "en" %}{% set aiMethodNote = true %}{% include "components/ai-notation.njk" %}
  </div>
</article>

{% set prevPost = collections.lab | getPrevPost(page.url) %}
{% set nextPost = collections.lab | getNextPost(page.url) %}
{% if prevPost or nextPost %}
<nav class="article-nav" data-pagefind-ignore>
  {% if prevPost %}
  <a href="{{ prevPost.url }}" class="article-nav-item article-nav-prev">
    <span class="article-nav-label">&#8592; Previous</span>
    <span class="article-nav-title">{{ prevPost.data.title }}</span>
  </a>
  {% else %}
  <span></span>
  {% endif %}
  {% if nextPost %}
  <a href="{{ nextPost.url }}" class="article-nav-item article-nav-next">
    <span class="article-nav-label">Next &#8594;</span>
    <span class="article-nav-title">{{ nextPost.data.title }}</span>
  </a>
  {% endif %}
</nav>
{% endif %}

<p style="margin-top: var(--spacing-lg); font-family: var(--font-sans); font-size: 14px;"><a href="/lab/">&larr; All Lab notes</a></p>
