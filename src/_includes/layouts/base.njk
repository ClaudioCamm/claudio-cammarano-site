{# isEN governa tutte le stringhe di interfaccia condivise fra le due
   lingue: testata, skip link, barra di consenso. Le pagine italiane
   passano dal ramo `else` e restano invariate. #}
{%- set isEN = (lang or 'it') == 'en' -%}
{# isENSurface e' piu' stretto: solo le pagine sotto /en/. La
   navigazione e il footer inglesi valgono li'. /lab/ ha lang: en ma
   resta raggiungibile dalla home italiana, quindi tiene la navigazione
   italiana e non perde il lettore che ci arriva da /. #}
{%- set isENSurface = page.url.indexOf('/en/') == 0 -%}
<!DOCTYPE html>
<html lang="{{ lang or 'it' }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if title %}{{ title }} - {% endif %}Claudio Cammarano</title>
    <meta name="description" content="{{ (description or 'Libri, mercati, idee') | stripMd }}">
    <link rel="canonical" href="https://claudiocammarano.com{{ page.url }}">
    <link rel="alternate" hreflang="{{ lang or 'it' }}" href="https://claudiocammarano.com{{ page.url }}">
    {% if translation %}<link rel="alternate" hreflang="{{ translation.lang }}" href="https://claudiocammarano.com{{ translation.url }}">
    <link rel="alternate" hreflang="x-default" href="https://claudiocammarano.com{% if (lang or 'it') == 'it' %}{{ page.url }}{% else %}{{ translation.url }}{% endif %}">
    {% else %}<link rel="alternate" hreflang="x-default" href="https://claudiocammarano.com/">{% endif %}
    <!-- Open Graph -->
    <meta property="og:title" content="{{ title or 'Claudio Cammarano' }}">
    <meta property="og:description" content="{{ (description or 'Libri, mercati, idee') | stripMd }}">
    <meta property="og:type" content="{{ og_type or 'website' }}">
    <meta property="og:url" content="https://claudiocammarano.com{{ page.url }}">
    {% if og_card %}
    <meta property="og:image" content="https://claudiocammarano.com{{ og_card }}">
    {% elif og_image %}
    <meta property="og:image" content="https://claudiocammarano.com{{ og_image }}">
    {% else %}
    <meta property="og:image" content="https://claudiocammarano.com/images/og-default.png">
    {% endif %}
    <meta property="og:site_name" content="Claudio Cammarano">
    <meta property="og:locale" content="{% if isEN %}en_GB{% else %}it_IT{% endif %}">
    {% if translation %}<meta property="og:locale:alternate" content="{% if isEN %}it_IT{% else %}en_GB{% endif %}">{% endif %}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:creator" content="@claudiocamm">
    <meta name="twitter:site" content="@claudiocamm">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
    <!-- Preload hero image (LCP) -->
    {% if og_image %}
    <link rel="preload" as="image" href="{{ og_image }}">
    {% endif %}
    <!-- DNS prefetch per risorse esterne -->
    <link rel="dns-prefetch" href="https://www.googletagmanager.com">
    <link rel="dns-prefetch" href="https://www.google-analytics.com">
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net">
    <!--
      Consent Mode v2. I default sono "denied" e vengono impostati PRIMA che
      gtag.js venga caricato: finche' l'utente non sceglie, GA4 non scrive
      cookie e raccoglie solo ping senza identificatori (ping che restano
      esclusi dalle metriche di utente). La scelta e' persistita in
      localStorage e riapplicata al caricamento successivo.
    -->
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      (function() {
        var stored = null;
        try { stored = localStorage.getItem('cc-consent'); } catch (e) {}
        var granted = stored === 'granted';
        gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: granted ? 'granted' : 'denied',
          functionality_storage: 'granted',
          security_storage: 'granted',
          wait_for_update: 500
        });
        window.ccConsentState = stored;
      })();
    </script>
    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-8557D7N1Y3"></script>
    <script>
      gtag('js', new Date());
      gtag('config', 'G-8557D7N1Y3', { anonymize_ip: true });
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400;1,8..60,500&display=swap" rel="stylesheet">
    <link rel="alternate" type="application/rss+xml" title="Claudio Cammarano" href="/feed.xml">
    <link rel="alternate" type="application/rss+xml" title="Claudio Cammarano — Lab" href="/lab/feed.xml">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="{{ bodyClass }}">
    <a class="skip-link" href="#main-content">{% if isENSurface %}Skip to content{% else %}Salta al contenuto{% endif %}</a>
    {% include "components/header.njk" %}

    <div class="container">
        <main data-pagefind-body id="main-content">
            {{ content | safe }}
        </main>
    </div>

    {% include "components/footer.njk" %}

    <div class="consent-bar" id="consent-bar" role="dialog" aria-live="polite" aria-label="{% if isENSurface %}Measurement preferences{% else %}Preferenze di misurazione{% endif %}" hidden>
      <div class="container consent-bar-inner">
        <p class="consent-bar-text">{% if isENSurface %}This site uses Google Analytics to count reads. Without consent no measurement cookie is written. <a href="/colophon/" lang="it">Details in the colophon (in Italian)</a>.{% else %}Questo sito usa Google Analytics per contare le letture. Senza consenso non viene scritto alcun cookie di misurazione. <a href="/colophon/">Dettagli nel colophon</a>.{% endif %}</p>
        <div class="consent-bar-actions">
          <button type="button" class="consent-btn consent-btn--ghost" data-consent="denied">{% if isENSurface %}Essential only{% else %}Solo essenziali{% endif %}</button>
          <button type="button" class="consent-btn consent-btn--solid" data-consent="granted">{% if isENSurface %}Accept{% else %}Accetto{% endif %}</button>
        </div>
      </div>
    </div>

    <script>
      // Banner di consenso: compare solo se non c'e' gia' una scelta salvata.
      (function() {
        var bar = document.getElementById('consent-bar');
        if (!bar) return;
        if (window.ccConsentState === 'granted' || window.ccConsentState === 'denied') return;
        bar.hidden = false;
        bar.addEventListener('click', function(e) {
          var btn = e.target.closest('[data-consent]');
          if (!btn) return;
          var choice = btn.getAttribute('data-consent');
          try { localStorage.setItem('cc-consent', choice); } catch (err) {}
          window.ccConsentState = choice;
          if (typeof gtag === 'function') {
            gtag('consent', 'update', { analytics_storage: choice === 'granted' ? 'granted' : 'denied' });
          }
          bar.hidden = true;
          document.dispatchEvent(new CustomEvent('cc:consent', { detail: choice }));
        });
      })();
    </script>

    <script>
      // Avvisa gli utenti di screen reader quando un link apre una nuova scheda
      (function() {
        var isEnglish = (document.documentElement.lang || '').indexOf('en') === 0;
        var label = isEnglish ? ' (opens in a new tab)' : ' (si apre in una nuova scheda)';
        document.querySelectorAll('a[target="_blank"]').forEach(function(a) {
          if (a.querySelector('.sr-only-newtab')) return;
          var span = document.createElement('span');
          span.className = 'sr-only sr-only-newtab';
          span.textContent = label;
          a.appendChild(span);
        });
      })();
    </script>

    <script>
      // Eventi GA4 per il funnel misurabile: intento newsletter (link interni
      // marcati data-newsletter-cta, con la posizione che li distingue),
      // newsletter (Substack), contatto (mailto), LinkedIn, download.
      // Da marcare come key event in GA4 Admin.
      //
      // Nota: il completamento dell'iscrizione avviene dentro l'embed Substack,
      // che e' un iframe cross-origin. form_start / form_submit non sono
      // osservabili da qui e non lo saranno mai: la metrica azionabile e'
      // newsletter_intent, il completamento si legge dal conteggio iscritti
      // su Substack.
      (function() {
        document.addEventListener('click', function(e) {
          if (typeof gtag !== 'function' || !e.target.closest) return;
          var a = e.target.closest('a[href]');
          if (!a) return;
          var href = a.getAttribute('href') || '';
          var abs = a.href || href;
          var params = { link_url: abs, page_path: location.pathname };
          if (a.hasAttribute('data-newsletter-cta')) {
            params.link_position = a.getAttribute('data-position') || 'unknown';
            gtag('event', 'newsletter_intent', params);
            return;
          }
          if (href.indexOf('mailto:') === 0) {
            gtag('event', 'contact_click', params);
          } else if (abs.indexOf('substack.com') !== -1) {
            gtag('event', 'substack_click', params);
          } else if (abs.indexOf('linkedin.com') !== -1 && abs.indexOf('share-offsite') === -1 && abs.indexOf('/sharing/') === -1) {
            gtag('event', 'linkedin_click', params);
          } else if (abs.indexOf('/downloads/') !== -1) {
            gtag('event', 'download_click', params);
          }
        }, true);
      })();
    </script>
</body>
</html>
