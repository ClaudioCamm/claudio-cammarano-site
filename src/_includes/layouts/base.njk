<!DOCTYPE html>
<html lang="{{ lang or 'it' }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if title %}{{ title }} - {% endif %}Claudio Cammarano</title>
    <meta name="description" content="{{ description or 'Libri, mercati, idee' }}">
    <link rel="canonical" href="https://claudiocammarano.com{{ page.url }}">
    <link rel="alternate" hreflang="{{ lang or 'it' }}" href="https://claudiocammarano.com{{ page.url }}">
    {% if translation %}<link rel="alternate" hreflang="{{ translation.lang }}" href="https://claudiocammarano.com{{ translation.url }}">
    <link rel="alternate" hreflang="x-default" href="https://claudiocammarano.com{% if (lang or 'it') == 'it' %}{{ page.url }}{% else %}{{ translation.url }}{% endif %}">
    {% else %}<link rel="alternate" hreflang="x-default" href="https://claudiocammarano.com/">{% endif %}
    <!-- Open Graph -->
    <meta property="og:title" content="{{ title or 'Claudio Cammarano' }}">
    <meta property="og:description" content="{{ description or 'Libri, mercati, idee' }}">
    <meta property="og:type" content="{{ og_type or 'website' }}">
    <meta property="og:url" content="https://claudiocammarano.com{{ page.url }}">
    {% if og_card %}
    <meta property="og:image" content="https://claudiocammarano.com{{ og_card }}">
    {% elif og_image %}
    <meta property="og:image" content="https://claudiocammarano.com{{ og_image }}">
    {% else %}
    <meta property="og:image" content="https://claudiocammarano.com/images/og-default.png">
    {% endif %}
    <meta property="og:site_name" content="Claudio Cammarano">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:creator" content="@claudiocamm">
    <meta name="twitter:site" content="@claudiocamm">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
    <!-- Preload hero image (LCP) -->
    {% if og_image %}
    <link rel="preload" as="image" href="{{ og_image }}">
    {% endif %}
    <!-- DNS prefetch per risorse esterne -->
    <link rel="dns-prefetch" href="https://www.googletagmanager.com">
    <link rel="dns-prefetch" href="https://www.google-analytics.com">
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net">
    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-8557D7N1Y3"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-8557D7N1Y3');
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400;1,8..60,500&display=swap" rel="stylesheet">
    <link rel="alternate" type="application/rss+xml" title="Claudio Cammarano" href="/feed.xml">
    <link rel="alternate" type="application/rss+xml" title="Claudio Cammarano — Lab" href="/episteme-advisory/lab/feed.xml">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
</head>
<body class="{{ bodyClass }}">
    <a class="skip-link" href="#main-content">Salta al contenuto</a>
    {% include "components/header.njk" %}

    <div class="container">
        <main data-pagefind-body id="main-content">
            {{ content | safe }}
        </main>
    </div>
    
    {% include "components/footer.njk" %}
    
    <script>
      if (window.netlifyIdentity) {
        window.netlifyIdentity.on("init", user => {
          if (!user) {
            window.netlifyIdentity.on("login", () => {
              document.location.href = "/admin/";
            });
          }
        });
      }
    </script>
    
    <script async src="//www.instagram.com/embed.js"></script>

    <script>
      // Avvisa gli utenti di screen reader quando un link apre una nuova scheda
      (function() {
        var isEnglish = (document.documentElement.lang || '').indexOf('en') === 0;
        var label = isEnglish ? ' (opens in a new tab)' : ' (si apre in una nuova scheda)';
        document.querySelectorAll('a[target="_blank"]').forEach(function(a) {
          if (a.querySelector('.sr-only-newtab')) return;
          var span = document.createElement('span');
          span.className = 'sr-only sr-only-newtab';
          span.textContent = label;
          a.appendChild(span);
        });
      })();
    </script>

    <script>
      // Eventi GA4 per il funnel misurabile: newsletter (Substack), contatto
      // (mailto), LinkedIn, download. Da marcare come key event in GA4 Admin.
      (function() {
        document.addEventListener('click', function(e) {
          if (typeof gtag !== 'function' || !e.target.closest) return;
          var a = e.target.closest('a[href]');
          if (!a) return;
          var href = a.getAttribute('href') || '';
          var abs = a.href || href;
          var params = { link_url: abs, page_path: location.pathname };
          if (href.indexOf('mailto:') === 0) {
            gtag('event', 'contact_click', params);
          } else if (abs.indexOf('substack.com') !== -1) {
            gtag('event', 'substack_click', params);
          } else if (abs.indexOf('linkedin.com') !== -1 && abs.indexOf('share-offsite') === -1 && abs.indexOf('/sharing/') === -1) {
            gtag('event', 'linkedin_click', params);
          } else if (abs.indexOf('/downloads/') !== -1) {
            gtag('event', 'download_click', params);
          }
        }, true);
      })();
    </script>
</body>
</html>
