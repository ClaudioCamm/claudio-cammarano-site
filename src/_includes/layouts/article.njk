---
layout: layouts/base.njk
og_type: article
---

<div id="reading-progress"></div>
<button id="back-to-top" aria-label="Torna su" title="Torna su">↑</button>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "headline": "{{ title | jsonEscape | safe }}",
      "description": "{{ description | jsonEscape | safe }}",
      "datePublished": "{{ date | isoDate }}",
      "url": "https://claudiocammarano.com{{ page.url }}",
      "image": "{% if og_image %}https://claudiocammarano.com{{ og_image }}{% else %}https://claudiocammarano.com/images/og-default.png{% endif %}",
      "author": {
        "@type": "Person",
        "@id": "https://claudiocammarano.com/#person",
        "name": "Claudio Cammarano",
        "url": "https://claudiocammarano.com/about/"
      },
      "publisher": {
        "@type": "Person",
        "@id": "https://claudiocammarano.com/#person"
      },
      "isPartOf": { "@id": "https://claudiocammarano.com/#website" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://claudiocammarano.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Writings",
          "item": "https://claudiocammarano.com/writings/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "{{ title | jsonEscape | safe }}",
          "item": "https://claudiocammarano.com{{ page.url }}"
        }
      ]
    }
  ]
}
</script>

<div class="print-header" aria-hidden="true">
  <span class="print-header-site">claudiocammarano.com</span>
  <span class="print-header-url">{{ page.url }}</span>
</div>

<article class="article-full">
  <header class="article-header">
    <div class="article-meta">
      <span class="article-date">{{ date | formatDate }}</span>
      {% if category %}
        {% if category.length %}
          {% for cat in category %}
          <a class="article-tag" href="/tag/{{ cat | slugify }}/">{{ cat }}</a>
          {% endfor %}
        {% else %}
        <a class="article-tag" href="/tag/{{ category | slugify }}/">{{ category }}</a>
        {% endif %}
      {% endif %}
      {% if content %}<span class="reading-time">{{ content | readingTime }}</span>{% endif %}
    </div>
    {% if series %}<p class="article-series"><a href="/serie/{{ series | seriesBaseName | slugify }}/">{{ series }}</a></p>{% endif %}
    <h1>{{ title }}</h1>
    {% if description %}
    <p class="article-description">{{ description }}</p>
    {% endif %}
    <div class="share-bar">
      <button class="share-btn" id="share-btn" aria-label="Condividi">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
        Condividi
      </button>
      <div class="share-menu" id="share-menu" hidden>
        <button class="share-menu-item" id="share-copy">Copia link</button>
        <a class="share-menu-item" id="share-linkedin" href="#" target="_blank" rel="noopener">LinkedIn</a>
        <a class="share-menu-item" id="share-twitter" href="#" target="_blank" rel="noopener">Twitter / X</a>
      </div>
    </div>
  </header>
  
  <div class="article-body" data-pagefind-body>
    {{ content | safe }}
  </div>
</article>

<div class="print-footer" aria-hidden="true">
  <span>© {{ date | isoDate | truncate(4, false, '') }} Claudio Cammarano — claudiocammarano.com</span>
  <span>Tutti i diritti riservati. Riproduzione consentita con citazione della fonte.</span>
</div>

<script>
(function() {
  // Table of contents
  var articleBody = document.querySelector('.article-body');
  if (articleBody) {
    var headings = articleBody.querySelectorAll('h2, h3');
    if (headings.length >= 3) {
      headings.forEach(function(h, i) {
        if (!h.id) {
          var slug = h.textContent
            .toLowerCase()
            .replace(/[^\w\s-]/g, '')
            .replace(/\s+/g, '-')
            .replace(/-+/g, '-')
            .trim();
          h.id = slug || ('sezione-' + i);
        }
      });
      var details = document.createElement('details');
      details.className = 'toc';
      var summary = document.createElement('summary');
      summary.className = 'toc-summary';
      summary.textContent = 'In questo articolo';
      details.appendChild(summary);
      var list = document.createElement('ol');
      list.className = 'toc-list';
      headings.forEach(function(h) {
        var li = document.createElement('li');
        li.className = 'toc-item toc-' + h.tagName.toLowerCase();
        var a = document.createElement('a');
        a.href = '#' + h.id;
        a.textContent = h.textContent;
        li.appendChild(a);
        list.appendChild(li);
      });
      details.appendChild(list);
      // Insert after first figure-wrapper (hero image), otherwise before first heading
      var heroFigure = articleBody.querySelector('.figure-wrapper');
      if (heroFigure) {
        heroFigure.parentNode.insertBefore(details, heroFigure.nextSibling);
      } else {
        var firstHeading = articleBody.querySelector('h2, h3');
        if (firstHeading) {
          firstHeading.parentNode.insertBefore(details, firstHeading);
        } else {
          articleBody.insertBefore(details, articleBody.firstChild);
        }
      }
    }
  }
})();
</script>

<script>
(function() {
  var bar = document.getElementById('reading-progress');
  var body = document.querySelector('.article-body');
  if (!bar || !body) return;
  function update() {
    var bodyTop = body.getBoundingClientRect().top + window.scrollY;
    var bodyHeight = body.offsetHeight;
    var scrolled = window.scrollY - bodyTop;
    var pct = Math.min(Math.max(scrolled / bodyHeight * 100, 0), 100);
    bar.style.width = pct + '%';
  }
  window.addEventListener('scroll', update, { passive: true });
  update();
})();

(function() {
  var shareBtn = document.getElementById('share-btn');
  var shareMenu = document.getElementById('share-menu');
  var shareCopy = document.getElementById('share-copy');
  var shareLinkedIn = document.getElementById('share-linkedin');
  var shareTwitter = document.getElementById('share-twitter');
  if (!shareBtn) return;

  var url = window.location.href;
  var title = document.title;

  if (shareLinkedIn) shareLinkedIn.href = 'https://www.linkedin.com/sharing/share-offsite/?url=' + encodeURIComponent(url);
  if (shareTwitter) shareTwitter.href = 'https://twitter.com/intent/tweet?url=' + encodeURIComponent(url) + '&text=' + encodeURIComponent(title);

  shareBtn.addEventListener('click', function() {
    if (navigator.share) {
      navigator.share({ title: title, url: url }).catch(function() {});
    } else {
      var open = !shareMenu.hidden;
      shareMenu.hidden = open;
    }
  });

  if (shareCopy) {
    shareCopy.addEventListener('click', function() {
      navigator.clipboard.writeText(url).then(function() {
        shareCopy.textContent = 'Copiato!';
        setTimeout(function() { shareCopy.textContent = 'Copia link'; shareMenu.hidden = true; }, 1800);
      });
    });
  }

  document.addEventListener('click', function(e) {
    if (!shareBtn.contains(e.target) && !shareMenu.contains(e.target)) {
      shareMenu.hidden = true;
    }
  });
})();

(function() {
  var btn = document.getElementById('back-to-top');
  if (!btn) return;
  window.addEventListener('scroll', function() {
    btn.classList.toggle('visible', window.scrollY > 400);
  }, { passive: true });
  btn.addEventListener('click', function() {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
})();
</script>

{% if series %}
  {% set seriesNav = collections.writings | getSeriesNav(series | seriesBaseName, page.url) %}
  {% if seriesNav %}
  <div class="series-nav">
    <div class="series-nav-header">
      <span class="series-nav-label">Serie</span>
      <a href="/serie/{{ series | seriesBaseName | slugify }}/" class="series-nav-title">{{ series | seriesBaseName }}</a>
      <span class="series-nav-count">{{ seriesNav.position }} di {{ seriesNav.total }}</span>
    </div>
    <div class="series-nav-items">
      {% if seriesNav.prev %}
      <a href="{{ seriesNav.prev.url }}" class="series-nav-item series-nav-item--prev">
        <span class="series-nav-direction">← Precedente</span>
        <span class="series-nav-item-title">{{ seriesNav.prev.data.title }}</span>
      </a>
      {% else %}<div></div>{% endif %}
      {% if seriesNav.next %}
      <a href="{{ seriesNav.next.url }}" class="series-nav-item series-nav-item--next">
        <span class="series-nav-direction">Successivo →</span>
        <span class="series-nav-item-title">{{ seriesNav.next.data.title }}</span>
      </a>
      {% endif %}
    </div>
  </div>
  {% endif %}
{% endif %}

<div class="newsletter-cta">
  <p class="newsletter-cta-label">The Abstract</p>
  <p class="newsletter-cta-text">Analisi su content industries, AI e media vista da una prospettiva europea. Esce su Substack.</p>
  <a href="https://claudiocammarano.substack.com" target="_blank" rel="noopener" class="newsletter-cta-btn">Leggi e iscriviti →</a>
</div>

{% set related = collections.writings | getRelatedPosts(page.url, category) %}
{% if related.length %}
<section class="related-posts">
  <h3 class="related-posts-title">Sullo stesso tema</h3>
  {% for post in related %}
  <article class="related-post">
    <div class="article-meta">
      <span class="article-date">{{ post.date | formatDate }}</span>
      {% if post.data.category %}
        {% if post.data.category.length %}
          {% for cat in post.data.category %}<a class="article-tag" href="/tag/{{ cat | slugify }}/">{{ cat }}</a>{% endfor %}
        {% else %}
          <a class="article-tag" href="/tag/{{ post.data.category | slugify }}/">{{ post.data.category }}</a>
        {% endif %}
      {% endif %}
    </div>
    <h4 class="related-post-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h4>
    {% if post.data.description %}<p class="related-post-description">{{ post.data.description }}</p>{% endif %}
  </article>
  {% endfor %}
</section>
{% endif %}

{% set prevPost = collections.writings | getPrevPost(page.url) %}
{% set nextPost = collections.writings | getNextPost(page.url) %}
{% if prevPost or nextPost %}
<nav class="article-nav">
  {% if prevPost %}
  <a href="{{ prevPost.url }}" class="article-nav-item article-nav-prev">
    <span class="article-nav-label">&#8592; Precedente</span>
    <span class="article-nav-title">{{ prevPost.data.title }}</span>
  </a>
  {% else %}
  <span></span>
  {% endif %}
  {% if nextPost %}
  <a href="{{ nextPost.url }}" class="article-nav-item article-nav-next">
    <span class="article-nav-label">Successivo &#8594;</span>
    <span class="article-nav-title">{{ nextPost.data.title }}</span>
  </a>
  {% endif %}
</nav>
{% endif %}
