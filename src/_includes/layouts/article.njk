---
layout: layouts/base.njk
og_type: article
---

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "{{ title | jsonEscape | safe }}",
  "description": "{{ description | jsonEscape | safe }}",
  "datePublished": "{{ date | isoDate }}",
  "url": "https://claudiocammarano.com{{ page.url }}",
  "image": "{% if og_image %}https://claudiocammarano.com{{ og_image }}{% else %}https://claudiocammarano.com/images/og-default.png{% endif %}",
  "author": {
    "@type": "Person",
    "name": "Claudio Cammarano",
    "url": "https://claudiocammarano.com/about/"
  }
}
</script>

<article class="article-full">
  <header class="article-header">
    <div class="article-meta">
      <span class="article-date">{{ date | formatDate }}</span>
      {% if category %}
        {% if category.length %}
          {% for cat in category %}
          <span class="article-tag">{{ cat }}</span>
          {% endfor %}
        {% else %}
        <span class="article-tag">{{ category }}</span>
        {% endif %}
      {% endif %}
    </div>
    <h1>{{ title }}</h1>
    {% if description %}
    <p class="article-description">{{ description }}</p>
    {% endif %}
  </header>
  
  <div class="article-body">
    {{ content | safe }}
  </div>
</article>
