{% for post in collections.writings | limit(10) %}
  {% if loop.index0 == 0 %}
  <article class="article-card article-card--featured">
    {% if post.data.series %}<div class="article-series-card-label"><a href="/serie/{{ post.data.series | seriesBaseName | slugify }}/">{{ post.data.series }}</a></div>{% endif %}
    <div class="article-meta">
      <span class="article-date">{{ post.date | formatDate }}</span>
      {% if post.data.category %}
        {% if post.data.category.length %}
          {% for cat in post.data.category %}<a class="article-tag" href="/tag/{{ cat | slugify }}/">{{ cat }}</a>{% endfor %}
        {% else %}
          <a class="article-tag" href="/tag/{{ post.data.category | slugify }}/">{{ post.data.category }}</a>
        {% endif %}
      {% endif %}
      {% if post.templateContent %}<span class="reading-time">{{ post.templateContent | readingTime }}</span>{% endif %}
    </div>
    <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
    {% if post.data.description %}<p class="featured-description">{{ post.data.description }}</p>{% endif %}
    {% if post.templateContent %}<p class="article-excerpt">{{ post.templateContent | excerpt(750) }}</p>{% endif %}
  </article>
  {% if collections.lab.length %}
  <a href="{{ collections.lab[0].url }}" class="lab-banner">
    <span class="lab-banner-label">Lab</span>
    <span class="lab-banner-title">{{ collections.lab[0].data.title }}</span>
    <span class="lab-banner-meta">
      {% if collections.lab[0].data.stage %}<span>{{ collections.lab[0].data.stage }}</span>{% endif %}
      <span>{{ collections.lab[0].data.date | formatDateEN }}</span>
      <span aria-hidden="true">→</span>
    </span>
  </a>
  {% endif %}
  {% elif loop.index0 <= 2 %}
  <article class="article-card article-card--secondary">
    {% if post.data.series %}<div class="article-series-card-label"><a href="/serie/{{ post.data.series | seriesBaseName | slugify }}/">{{ post.data.series }}</a></div>{% endif %}
    <div class="article-meta">
      <span class="article-date">{{ post.date | formatDate }}</span>
      {% if post.data.category %}
        {% if post.data.category.length %}
          {% for cat in post.data.category %}<a class="article-tag" href="/tag/{{ cat | slugify }}/">{{ cat }}</a>{% endfor %}
        {% else %}
          <a class="article-tag" href="/tag/{{ post.data.category | slugify }}/">{{ post.data.category }}</a>
        {% endif %}
      {% endif %}
      {% if post.templateContent %}<span class="reading-time">{{ post.templateContent | readingTime }}</span>{% endif %}
    </div>
    <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
    {% if post.data.description %}<p class="article-card-subtitle">{{ post.data.description }}</p>{% endif %}
    {% if post.templateContent %}<p class="article-excerpt">{{ post.templateContent | excerpt }}</p>{% endif %}
  </article>
  {% else %}
  <article class="article-card article-card--secondary">
    {% if post.data.series %}<div class="article-series-card-label"><a href="/serie/{{ post.data.series | seriesBaseName | slugify }}/">{{ post.data.series }}</a></div>{% endif %}
    <div class="article-meta">
      <span class="article-date">{{ post.date | formatDate }}</span>
      {% if post.data.category %}
        {% if post.data.category.length %}
          {% for cat in post.data.category %}<a class="article-tag" href="/tag/{{ cat | slugify }}/">{{ cat }}</a>{% endfor %}
        {% else %}
          <a class="article-tag" href="/tag/{{ post.data.category | slugify }}/">{{ post.data.category }}</a>
        {% endif %}
      {% endif %}
      {% if post.templateContent %}<span class="reading-time">{{ post.templateContent | readingTime }}</span>{% endif %}
    </div>
    <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
    {% if post.data.description %}<p class="article-card-subtitle">{{ post.data.description }}</p>{% endif %}
  </article>
  {% endif %}
{% endfor %}

{% if abstract.posts and abstract.posts.length > 0 %}
<div class="abstract-block">
  <div class="abstract-block-header">
    <span class="abstract-block-label">From The Abstract</span>
    <p class="abstract-block-tagline">Reading the Content Economy from Europe</p>
  </div>
  {% for post in abstract.posts | limit(5) %}
  <article class="abstract-block-post">
    <div class="article-meta">
      {% if post.date %}<span class="article-date">{{ post.date }}</span>{% endif %}
      <span class="article-tag">The Abstract</span>
    </div>
    <h3 class="abstract-block-post-title">
      <a href="{{ post.url }}" target="_blank" rel="noopener">{{ post.title }} ↗</a>
    </h3>
    {% if loop.index0 == 0 and post.excerpt %}
    <p class="abstract-block-post-excerpt">{{ post.excerpt }}</p>
    {% elif loop.index0 > 0 and post.subtitle %}
    <p class="abstract-block-post-excerpt">{{ post.subtitle }}</p>
    {% endif %}
  </article>
  {% endfor %}
  <p class="abstract-block-cta">
    <a href="https://claudiocammarano.substack.com" target="_blank" rel="noopener">Read more on Substack →</a>
  </p>
</div>
{% endif %}

{% for post in collections.curated | limit(3) %}
  <article class="article-card article-card--curated">
    <div class="article-meta">
      <span class="curated-badge">Curated</span>
      {% if post.data.source %}
      <span class="curated-source-label">· {{ post.data.source }}</span>
      {% endif %}
      {% if post.data.tags %}
        {% for tag in post.data.tags %}{% if tag != 'curated' %}{% set canonical = curatedTagAliases[tag | lower] %}{% if canonical %}<a class="article-tag" href="/tag/{{ canonical | slugify }}/">{{ canonical }}</a>{% endif %}{% endif %}{% endfor %}
      {% endif %}
    </div>
    <h2><a href="{{ post.data.external_url }}" target="_blank">{{ post.data.title }} ↗</a></h2>
    {% if post.data.description %}
    <p>{{ post.data.description }}</p>
    {% endif %}
    {% if post.data.concepts and post.data.concepts.length %}
    <div class="concetto-chips curated-concepts">
      {% for cname in post.data.concepts %}
      <a href="/concetti/{{ cname | slugify }}/" class="concetto-chip">{{ cname }}</a>
      {% endfor %}
    </div>
    {% endif %}
  </article>
{% endfor %}
