{# Definizione canonica della Person: un solo nodo #person in tutto il sito #}
{% include "components/person-jsonld.njk" %}

{# ===================================================================
   HOME v3 — impianto a fasce.
   Ogni sezione e' una fascia orizzontale a piena larghezza che si
   chiude da sola: niente piu' due colonne parallele di altezza
   diversa, quindi niente code disallineate.
   Ordine: apertura, in evidenza, Lab, Writings, Curated, The
   Abstract, Sommario ragionato (mappa del sito, quindi in coda).
   =================================================================== #}

{# === 1 · APERTURA: tesi, credenziali, due porte di lettura === #}
<section class="home-hero" aria-label="Apertura">
  <h1 class="home-title"><span class="home-title-line">Le idee sono cose reali.</span> <span class="home-title-line">Il mercato è dove si incontrano.</span></h1>
  <p class="home-positioning">Le idee esistono: come i sassi, i fiori, i bambini. Una tesi ontologica presa sul serio, e un'industria che la mette alla prova ogni giorno. Editoria, epistemologia, geopolitica dei contenuti.</p>
  <p class="home-hero-why"><a href="/writings/2026-04-30-la-differenza-fra-claude-e-le-mie-gatte/">Perché lo penso davvero &#8594;</a></p>

  <div class="home-hero-foot">
    <p class="home-credentials">Vent'anni di marketing editoriale, oggi in De Agostini Libri. Prima Mondadori, Rizzoli, RCS, GEDI. Insegno all'Università Cattolica, a Parma e anche altrove. Autore di <cite>Il mercato del libro</cite> (Solferino).</p>

    <div class="home-cta-row">
      <a class="btn-about home-cta-primary" href="/writings/">Comincia a leggere</a>
      <a class="home-cta-secondary" href="/da-qui/">Oppure: da qui &#8594;</a>
    </div>

    <p class="home-service"><a href="/about/">Chi sono</a> <span aria-hidden="true">·</span> Lavorare con me: <a class="home-service-irene" href="/irene-media/">Irene Media</a> <span aria-hidden="true">·</span> <a class="home-service-episteme" href="/episteme-advisory/">Episteme Advisory</a> <span aria-hidden="true">·</span> <a href="mailto:claudio@claudiocammarano.com">Contatti</a></p>
  </div>

  {# Cattura sopra la piega: una riga, subordinata alle due porte, non un form.
     Il form vero sta su /newsletter/. Nessun verbo imperativo. #}
  <p class="home-abstract-hint"><a href="/newsletter/" data-newsletter-cta data-position="home_hero">The Abstract &#8212; la newsletter in inglese, un saggio al mese sull'economia dei contenuti &#8594;</a></p>
</section>

{# === 2 · IN EVIDENZA: rail con i metadati + titolo, standfirst, anteprima === #}
{% set featured = collections.writings[0] %}
{% if featured %}
<section class="home-band home-band--featured" aria-label="In evidenza">
  <div class="home-featured">
    <div class="home-featured-rail">
      {% if featured.data.series %}<div class="article-series-card-label"><a href="/serie/{{ featured.data.series | seriesBaseName | slugify }}/">{{ featured.data.series }}</a></div>{% endif %}
      <div class="article-meta">
        <span class="article-date">{{ featured.date | formatDate }}</span>
        {% if featured.templateContent %}<span class="reading-time">{{ featured.templateContent | readingTime }}</span>{% endif %}
        {% if featured.data.category %}
          {% if featured.data.category.length %}
            {% for cat in featured.data.category %}<a class="article-tag" href="/tag/{{ cat | slugify }}/">{{ cat }}</a>{% endfor %}
          {% else %}
            <a class="article-tag" href="/tag/{{ featured.data.category | slugify }}/">{{ featured.data.category }}</a>
          {% endif %}
        {% endif %}
      </div>
    </div>
    <article class="article-card article-card--featured">
      <h2><a href="{{ featured.url }}">{{ featured.data.title }}</a></h2>
      {% if featured.data.description %}<p class="featured-description">{{ featured.data.description | mdInline | safe }}</p>{% endif %}
      {% if featured.templateContent %}
      <p class="article-excerpt">{{ featured.templateContent | excerpt(700) }}</p>
      <p class="featured-continua"><a href="{{ featured.url }}">Continua a leggere &#8594;</a></p>
      {% endif %}
    </article>
  </div>
</section>
{% endif %}

{# === 3 · LAB: anteprima estesa della nota piu' recente + le successive === #}
{% if collections.lab.length %}
{% set labFeature = collections.lab[0] %}
<section class="home-band home-band--lab" aria-label="Lab">
  <div class="home-lab-head">
    <div>
      <span class="home-lab-label">Lab · Episteme Advisory</span>
      <p class="home-lab-intro">Dated, in-progress research notes. Not finished essays — the open work behind the research on post-cognition and the validation of language model outputs.</p>
    </div>
    <p class="home-lab-all"><a href="/episteme-advisory/lab/">Tutte le note &#8594;</a></p>
  </div>
  <div class="home-lab">
    <article class="home-lab-feature">
      <div class="article-meta">
        <span class="article-date">{{ labFeature.data.date | formatDateEN }}</span>
        {% if labFeature.data.project %}<span class="article-tag">{{ labFeature.data.project }}</span>{% endif %}
        {% if labFeature.data.stage %}<span class="home-lab-stage">{{ labFeature.data.stage }}</span>{% endif %}
      </div>
      <h3><a href="{{ labFeature.url }}">{{ labFeature.data.title }}</a></h3>
      {% if labFeature.data.description %}<p class="home-lab-abstract">{{ labFeature.data.description }}</p>{% endif %}
      <p><a class="home-lab-go" href="{{ labFeature.url }}">Leggi la nota &#8594;</a></p>
    </article>
    {% if collections.lab.length > 1 %}
    <div class="home-lab-more">
      <p class="home-lab-more-title">Note recenti</p>
      {% for nota in collections.lab | limit(4) %}{% if loop.index0 > 0 %}
      <a class="home-lab-item" href="{{ nota.url }}">
        <span class="home-lab-item-meta">{{ nota.data.date | formatDateEN }}{% if nota.data.stage %} · {{ nota.data.stage }}{% endif %}</span>
        <span class="home-lab-item-title">{{ nota.data.title }}</span>
      </a>
      {% endif %}{% endfor %}
    </div>
    {% endif %}
  </div>
</section>
{% endif %}

{# === 4 · WRITINGS: griglia, estratti troncati, meta allineate in fondo === #}
<section class="home-band home-band--writings" aria-label="Writings">
  <div class="home-sec-head">
    <h2 class="home-sec-title">Writings</h2>
    <a class="home-sec-link" href="/writings/">Tutti &#8594;</a>
  </div>
  <div class="writings-compact">
    {% for post in collections.writings | limit(7) %}{% if loop.index0 > 0 %}
    <article class="article-card article-card--compact">
      {% if post.data.series %}<div class="article-series-card-label"><a href="/serie/{{ post.data.series | seriesBaseName | slugify }}/">{{ post.data.series }}</a></div>{% endif %}
      <h3 class="article-card-compact-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
      {% if post.data.description %}<p class="article-card-subtitle">{{ post.data.description | mdInline | safe }}</p>{% endif %}
      <div class="article-meta">
        <span class="article-date">{{ post.date | formatDate }}</span>
        {% if post.data.category %}
          {% if post.data.category.length %}
            {# In home massimo 2 tag; tutti sulla pagina Writings #}
            {% for cat in post.data.category %}{% if loop.index0 < 2 %}<a class="article-tag" href="/tag/{{ cat | slugify }}/">{{ cat }}</a>{% endif %}{% endfor %}
          {% else %}
            <a class="article-tag" href="/tag/{{ post.data.category | slugify }}/">{{ post.data.category }}</a>
          {% endif %}
        {% endif %}
        {% if post.templateContent %}<span class="reading-time">{{ post.templateContent | readingTime }}</span>{% endif %}
      </div>
    </article>
    {% endif %}{% endfor %}
  </div>
</section>

{# === 5 · CURATED: fascia a piena larghezza, le glosse hanno respiro === #}
<section class="home-band home-band--tinted home-band--curated" aria-label="Curated">
  <div class="home-sec-head">
    <h2 class="home-sec-title">Curated</h2>
    <a class="home-sec-link" href="/curated/">Tutti &#8594;</a>
  </div>
  <p class="curated-framing">Letture da altre testate, schedate per l'uso: il badge dice che cosa ho trovato in ogni pezzo, la riga sotto perché è qui.</p>
  <div class="home-curated">
    {% for post in collections.curated | limit(3) %}
    <article class="article-card article-card--curated article-card--curated-compact">
      <div class="article-meta">
        <span class="curated-badge">Curated</span>
        {% if post.data.source %}
        <span class="curated-source-label">· <a href="{{ post.data.external_url }}" target="_blank" rel="noopener noreferrer">{{ post.data.source }} ↗</a></span>
        {% endif %}
      </div>
      <h3 class="curated-compact-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
      {% set criterioSlug = post.data.criterio %}{% set criterioPerche = post.data.perche %}{% include "components/criterio-badge.njk" %}
    </article>
    {% endfor %}
  </div>
  <p class="curated-all"><a href="/curated/">Tutte le segnalazioni &#8594;</a></p>
</section>

{# === 6 · THE ABSTRACT: fascia orizzontale a tre voci === #}
{% if abstract.posts and abstract.posts.length > 0 %}
<section class="home-band home-band--abstract" aria-label="From The Abstract">
  <div class="abstract-block">
    <div class="home-abstract-head">
      <span class="abstract-block-label">From The Abstract</span>
      <p class="abstract-block-tagline">Reading the Content Economy from Europe</p>
    </div>
    <div class="home-abstract-posts">
      {% for post in abstract.posts | limit(3) %}
      <article class="abstract-block-post">
        <div class="article-meta">
          {% if post.date %}<span class="article-date">{{ post.date }}</span>{% endif %}
        </div>
        <h3 class="abstract-block-post-title">
          <a href="{{ post.url }}" target="_blank" rel="noopener">{{ post.title }} ↗</a>
        </h3>
        {% if post.excerpt %}
        <p class="abstract-block-post-excerpt">{{ post.excerpt }}</p>
        {% elif post.subtitle %}
        <p class="abstract-block-post-excerpt">{{ post.subtitle }}</p>
        {% endif %}
      </article>
      {% endfor %}
    </div>
    <p class="abstract-block-cta">
      <a href="https://claudiocammarano.substack.com" target="_blank" rel="noopener">Read more on Substack →</a>
    </p>
  </div>
</section>
{% endif %}

{# === 7 · SOMMARIO RAGIONATO: mappa del sito, in coda === #}
<section class="home-band home-band--tinted home-band--sommario" aria-label="Sommario ragionato">
  {% include "components/sistema-figurato.njk" %}
</section>
