{# Definizione canonica della Person: un solo nodo #person in tutto il sito #}
{% include "components/person-jsonld.njk" %}


{# ===================================================================
   HOME — revisione "Tavole" (ott 2026).
   La pagina e' una sequenza di tavole numerate: ogni tavola mostra una
   parte dell'apparato invece di descriverla. Ordine: la tesi con la carta,
   i numeri del corpus, le catene per linee, i saggi, il Lab, le schede,
   gli strati di ENTIA, il sommario; le richieste solo in fondo.
   =================================================================== #}
{% set writingsSaggi = collections.writings | senzaCatene %}
{% set catenePubblicate = collections.writings | soloCatene %}
{% set featured = writingsSaggi[0] %}
{% set catenaHome = catenePubblicate | catenaInEvidenza %}
{% set linee = collections.writings | lineeSerie %}
{% set carta = collections.mergedConceptsIndex | cartaGeo({ geom: "bergamo" }) %}

{# === APERTURA: la tesi e la carta === #}
<section class="tv-hero" aria-label="Apertura">
  <div class="tv-hero-testo">
    <p class="tv-k">La tesi</p>
    <h1 class="home-title"><span class="home-title-line">Le idee sono cose reali.</span> <span class="home-title-line">Il mercato è dove si incontrano.</span></h1>
    <p class="home-positioning">Le idee esistono: come i sassi, i fiori, i bambini. Una tesi ontologica presa sul serio, e un'industria che la mette alla prova ogni giorno. Editoria, epistemologia, geopolitica dei contenuti.</p>
    <p class="home-credentials">Vent'anni di marketing editoriale, oggi in De Agostini Libri. Prima Mondadori, Rizzoli, RCS, GEDI. Insegno all'Università Cattolica, a Parma e anche altrove. Autore di <cite>Il mercato del libro</cite> (Solferino).</p>
    <div class="home-cta-row">
      <a class="btn-about home-cta-primary" href="/writings/">Comincia a leggere</a>
      <a class="home-cta-secondary" href="/da-qui/">Oppure: da qui &#8594;</a>
      <a class="home-cta-secondary tv-why" href="/writings/2026-04-30-la-differenza-fra-claude-e-le-mie-gatte/">Perché lo penso davvero &#8594;</a>
    </div>
  </div>
  {% if carta.legenda.length %}
  <div class="tv-hero-carta home-carta">
    <figure class="carta-figura">
      {{ carta.svg | safe }}
      <figcaption class="carta-didascalia"><b>Dove guarda questo sito.</b> Proiezione azimutale equivalente, centrata su dove scrivo: ogni 30° di arco sono circa 3.300 km.</figcaption>
    </figure>
    <ol class="tv-carta-voci">
      {% for v in carta.legenda | limit(8) %}<li><span class="carta-sw carta-c{{ v.classe }}" aria-hidden="true"></span><a href="{{ v.url }}">{{ v.nome }}</a> <b>{{ v.peso }}</b></li>{% endfor %}
    </ol>
    <p class="tv-carta-metodo">Il numero è un peso, non un conteggio. <a href="/colophon/#carta">Il metodo &#8594;</a>{% if carta.altri %} · <a href="/indice/#paesi">Altri {{ carta.altri }} paesi &#8594;</a>{% endif %}</p>
  </div>
  {% endif %}
</section>

{# === I NUMERI DEL CORPUS === #}
<section class="tv-numeri" aria-label="Il corpus">
  <a href="/writings/"><b>{{ writingsSaggi.length }}</b><span>Saggi</span></a>
  <a href="/catene/" class="c-catena"><b>{{ catenePubblicate.length }}</b><span>Catene</span></a>
  <a href="/curated/" class="c-scheda"><b>{{ collections.curated.length }}</b><span>Schede curated</span></a>
  <a href="/indice/" class="c-serie"><b>{{ collections.mergedConceptsIndex.length }}</b><span>Concetti</span></a>
  <a href="/entia/" class="tv-entia"><b>ENTIA</b><span>Metodo {{ entia.spec }} · DOI {{ entia.deposito.doi }}</span></a>
</section>

{# === TAV. I · LE CATENE, PER LINEE ===
   Le serie sono linee con le parti in ordine di lettura; il cerchio vuoto
   e' l'ultima uscita. Nessuna parte compare da sola (vedi lib/tavole.js). #}
{% if catenaHome %}
<section class="tv-tav tv-tav--catene" aria-labelledby="tav-catene">
  <header class="tv-th"><p class="tv-n">I</p><div><h2 id="tav-catene">Le catene</h2><p>Saggi montati sulle schede attorno a una tesi. Le serie si leggono per linee, in ordine di parte e non di uscita: il cerchio vuoto è l’ultima uscita.</p></div><a class="tv-tutte" href="/catene/">Tutte le catene &#8594;</a></header>

  <div class="tv-catena-ev">
    <div>
      <p class="tv-meta"><b>Ultima catena</b>{% if catenaHome.data.series %} · {{ catenaHome.data.series | seriesBaseName }}, {{ catenaHome.data.series | parteDi(collections.writings) }}{% endif %} · {{ catenaHome.date | formatDate }}</p>
      <h3><a href="{{ catenaHome.url }}">{{ catenaHome.data.title }}</a></h3>
      <p class="tv-tesi">{{ (catenaHome.data.tesi or catenaHome.data.description) | mdInline | safe }}</p>
      <p class="tv-go"><a href="{{ catenaHome.url }}">Leggi la catena &#8594;</a></p>
    </div>
    <div>
      <p class="tv-perle" aria-hidden="true">{% for f in catenaHome.data.fonti %}<i></i>{% endfor %}</p>
      <ol class="tv-fonti">
        {% for f in catenaHome.data.fonti | catenaFonti %}<li><span>{{ f.testata }}</span><a href="{{ f.url }}">{{ f.title }}</a></li>{% endfor %}
      </ol>
    </div>
  </div>

  <div class="tv-linee">
    {% for l in linee | limit(6) %}
    <div class="tv-linea{% if loop.index > 3 %} is-extra{% endif %}">
      <p class="tv-linea-nome"><a href="/serie/{{ l.nome | slugify }}/">{{ l.nome }}</a><span>{% if l.saggi %}{{ l.saggi }} {{ "saggio" if l.saggi == 1 else "saggi" }}{% endif %}{% if l.saggi and l.catene %} · {% endif %}{% if l.catene %}{{ l.catene }} {{ "catena" if l.catene == 1 else "catene" }}{% endif %} · agg. {{ l.aggiornata | formatDate }}</span></p>
      <ol class="tv-fermate">
        {% for v in l.parti %}<li class="is-{{ v.tipo }}{% if v.nuova %} is-nuova{% endif %}"><a href="{{ v.url }}"><span class="tv-pallino" aria-hidden="true"></span><span class="tv-num">{{ v.romano }}</span><span class="tv-tit">{{ v.titolo }}</span>{% if v.nuova %}<span class="tv-ult">ultima uscita</span>{% endif %}</a></li>{% endfor %}
      </ol>
    </div>
    {% endfor %}
  </div>
  {% if linee.length > 3 %}<p class="tv-altre-linee"><a href="/catene/#linee">Altre {{ (linee.length if linee.length < 6 else 6) - 3 }} linee &#8594;</a></p>{% endif %}
  {% set sciolte = catenePubblicate | catenePerMese %}
  {% if sciolte.length %}
  <p class="tv-sciolte"><b>Fuori serie</b>{% for g in sciolte | limit(1) %}{% for c in g.catene | limit(4) %} · <a href="{{ c.url }}">{{ c.titolo }}</a>{% endfor %}{% endfor %} · <a href="/catene/#fuori-serie">tutte &#8594;</a></p>
  {% endif %}
</section>
{% endif %}

{# === TAV. II · SAGGI === #}
{% if featured %}
<section class="tv-tav tv-tav--saggi" aria-labelledby="tav-saggi">
  <header class="tv-th"><p class="tv-n">II</p><div><h2 id="tav-saggi">Saggi lunghi, misurati in minuti</h2><p>Ogni saggio esce anche in PDF ed ePub, con bibliografia e posizione nella serie.</p></div><a class="tv-tutte" href="/writings/">Tutti &#8594;</a></header>
  <article class="tv-saggio-ev">
    <p class="tv-meta">{% if featured.data.series %}<a href="/serie/{{ featured.data.series | seriesBaseName | slugify }}/">{{ featured.data.series }}</a> · {% endif %}{{ featured.date | formatDate }}{% if featured.data.category %}{% for cat in featured.data.category %} · <a href="/tag/{{ cat | slugify }}/">{{ cat }}</a>{% endfor %}{% endif %}</p>
    <h3><a href="{{ featured.url }}">{{ featured.data.title }}</a></h3>
    {% if featured.data.description %}<p class="tv-tesi">{{ featured.data.description | mdInline | safe }}</p>{% endif %}
    <div class="tv-saggio-corpo">
      <p class="article-excerpt">{{ featured.templateContent | excerpt(520) }}</p>
      <p class="tv-min"><b>{{ featured.templateContent | minuti }}′</b><span>di lettura</span><a href="{{ featured.url }}">Continua a leggere &#8594;</a></p>
    </div>
  </article>
  {% set listaSaggi = writingsSaggi | escludiUrl([featured.url]) | limit(5) %}
  {% set maxMin = 60 %}
  <ol class="tv-saggi">
    {% for post in listaSaggi %}{% if post %}
    <li>
      <p class="tv-serie-lbl">{% if post.data.series %}<a href="/serie/{{ post.data.series | seriesBaseName | slugify }}/">{{ post.data.series }}</a>{% else %}Saggio{% endif %}</p>
      <div><h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>{% if post.data.description %}<p>{{ post.data.description | mdInline | safe }}</p>{% endif %}</div>
      {% set m = post.templateContent | minuti %}
      <p class="tv-barra"><i style="width: {{ (m / maxMin * 100) if m < maxMin else 100 }}%"></i><b>{{ m }}′</b><span>{{ post.date | formatDate }}</span></p>
    </li>
    {% endif %}{% endfor %}
  </ol>
</section>
{% endif %}

{# === LAB: campitura verde, in inglese e lo dice === #}
{% if collections.lab.length %}
{% set labFeature = collections.lab[0] %}
<section class="tv-lab" aria-label="Lab">
  <p class="tv-lab-k"><a href="/lab/">Lab</a> · note di ricerca in corso, in inglese · {{ labFeature.data.date | formatDate }}{% if labFeature.data.stage %} · <span lang="en">{{ labFeature.data.stage }}</span>{% endif %}</p>
  <h2 lang="en"><a href="{{ labFeature.url }}">{{ labFeature.data.title }}</a></h2>
  {% if labFeature.data.description %}<p lang="en">{{ labFeature.data.description | excerpt(260) }}</p>{% endif %}
  <p class="tv-lab-go"><a href="{{ labFeature.url }}">Leggi la nota, in inglese &#8594;</a> <a href="/lab/">Tutte le note &#8594;</a> <a href="/en/">Research EN &#8594;</a></p>
</section>
{% endif %}

{# === TAV. III · SCHEDE CURATED === #}
<section class="tv-tav tv-tav--curated" aria-labelledby="tav-curated">
  <header class="tv-th"><p class="tv-n">III</p><div><h2 id="tav-curated">Le schede</h2><p>Letture da altre testate, schedate per l’uso: il badge dice che cosa ho trovato in ogni pezzo, la riga sotto perché è qui.</p></div><a class="tv-tutte" href="/curated/">Tutte &#8594;</a></header>
  <div class="home-curated">
    {% for post in collections.curated | limit(3) %}
    <article class="article-card article-card--curated article-card--curated-compact">
      <div class="article-meta">
        {% if post.data.source %}<span class="curated-source-label"><a href="{{ post.data.external_url }}" target="_blank" rel="noopener noreferrer">{{ post.data.source }} ↗</a></span>{% endif %}
      </div>
      <h3 class="curated-compact-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
      {% set criterioSlug = post.data.criterio %}{% set criterioPerche = post.data.perche %}{% set linguaFonte = post.data.lingua_fonte %}{% include "components/criterio-badge.njk" %}
    </article>
    {% endfor %}
  </div>
</section>

{# === TAV. IV · GLI STRATI (ENTIA) === #}
<section class="tv-tav tv-tav--strati" aria-labelledby="tav-strati">
  <header class="tv-th"><p class="tv-n">IV</p><div><h2 id="tav-strati">Gli strati</h2><p>Il metodo con cui il sito classifica sé stesso, depositato come protocollo aperto: cinque strati, dal meno al più esposto all’errore.</p></div><a class="tv-tutte" href="/entia/">La specifica &#8594;</a></header>
  <div class="tv-strati">
    <div class="tv-epigrafe">
      <p class="tv-latino">Entia non sunt multiplicanda praeter necessitatem.</p>
      <p>ENTIA, <span lang="en">Epistemic Notation for Texts In Archives</span>, dichiara pezzo per pezzo a che cosa serve nell’archivio, non di che cosa parla.</p>
      <p class="tv-meta">ENTIA {{ entia.spec }} · {{ entia.licenza.nome }} · <a href="{{ entia.deposito.url }}">DOI {{ entia.deposito.doi }}</a></p>
    </div>
    <div>
    <p class="tv-strato-testa" aria-hidden="true"><span></span><span></span><span>Che cosa fa</span><span>Chi lo controlla</span></p>
    <ol class="tv-strato-lista">
      {% for s in entia.strati %}<li class="tv-strato tv-strato--{{ loop.index }}"><span class="tv-sn">{{ s.nome }}</span><b>{{ s.quanti }}</b><span class="tv-sd"><span class="tv-sl">Che cosa fa</span>{{ s.fa }}</span><span class="tv-sd"><span class="tv-sl">Chi lo controlla</span>{{ s.controllo }}</span></li>{% endfor %}
    </ol>
    </div>
  </div>
</section>

{# === TAV. V · SOMMARIO RAGIONATO (treemap dei temi) === #}
{% set sfTotArgomenti = 0 %}{% for cName, cTags in clusters %}{% set sfTotArgomenti = sfTotArgomenti + cTags.length %}{% endfor %}
<section class="tv-tav tv-tav--sommario" aria-labelledby="tav-sommario">
  <header class="tv-th"><p class="tv-n">V</p><div><h2 id="tav-sommario">Sommario ragionato</h2><p>{{ clusters | length }} temi · {{ sfTotArgomenti }} argomenti · {{ collections.mergedConceptsIndex.length }} concetti. L’area di ogni tema è proporzionale ai suoi argomenti.</p></div><a class="tv-tutte" href="/mappa/">Esplora la mappa &#8594;</a></header>
  <div class="tv-treemap">
    {% for t in clusters | treemapTemi(sistemaFigurato.rami) %}
    <div class="tv-tema{% if loop.first %} is-primo{% endif %}{% if t.h < 45 %} is-basso{% endif %}" style="left:{{ t.x }}%;top:{{ t.y }}%;width:{{ t.w }}%;height:{{ t.h }}%;--c:var(--graph-cluster-{{ t.colore }})">
      <a href="/temi/#{{ t.nome | slugify }}"><b>{{ t.n }}</b><span class="tv-tema-nome">{{ t.nome }}</span></a>
      <p>{% for tag in t.argomenti | limit(5 if loop.first else 3) %}<a href="/tag/{{ tag | slugify }}/">{{ tag }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</p>
    </div>
    {% endfor %}
  </div>
  <p class="tv-firma"><a href="/indice/">Indice &#8594;</a> · <a href="/serie/">Le serie &#8594;</a> · Carta, concetti e indici a cura di <a class="home-service-irene" href="/irene-media/">Irene Media</a></p>
</section>

{# === FINE: le richieste, in coda (parere 27/9) === #}
<section class="tv-fine" aria-label="Lavorare con me">
  <p class="tv-n">Fine</p>
  <div class="tv-fine-b tv-fine-b--abstract">
    <p class="tv-meta">The Abstract</p>
    <h3>Un saggio al mese, in inglese, dall’Europa.</h3>
    {% if abstract.posts and abstract.posts.length > 0 %}<ul>{% for post in abstract.posts | limit(3) %}<li><a href="{{ post.url }}" target="_blank" rel="noopener">{{ post.title }} ↗</a></li>{% endfor %}</ul>{% endif %}
    <a class="tv-cta" href="/newsletter/" data-newsletter-cta data-position="home_coda">Le uscite e l’iscrizione &#8594;</a>
  </div>
  <div class="tv-fine-b tv-fine-b--lavoro">
    <p class="tv-meta">Lavorare con me</p>
    <h3>Irene Media · Episteme Advisory</h3>
    <p>Chi costruisce l’apparato, e chi lo valida.</p>
    <a class="tv-cta" href="/irene-media/">Irene Media &#8594;</a> <a class="tv-cta" href="/episteme-advisory/">Episteme Advisory &#8594;</a>
  </div>
  <div class="tv-fine-b">
    <p class="tv-meta">Contatti</p>
    <h3>Scrivimi</h3>
    <p>Per letture, insegnamento, collaborazioni.</p>
    <a class="tv-cta" href="mailto:claudio@claudiocammarano.com">claudio@claudiocammarano.com</a>
  </div>
</section>

<script src="/js/globo.js" defer></script>
