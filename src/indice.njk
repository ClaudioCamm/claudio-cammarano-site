            {% if concept.articles.length > 1 %}<span class="indice-count" aria-label="{{ concept.articles.length }} articoli">{{ concept.articles.length }}</span>{% endif %}
          </dt>
          <dd class="indice-articles">
            {% for art in concept.articles %}
            <a href="{{ art.url }}" class="indice-article-link{% if art._source == 'curated' %} indice-article-link--curated{% elif art._source == 'lab' %} indice-article-link--lab{% endif %}">{{ art.title }}{% if art._source == 'curated' %}<span class="indice-curated-badge" aria-label="curated">c</span>{% elif art._source == 'lab' %}<span class="indice-lab-badge" aria-label="lab">lab</span>{% endif %}</a>{% if not loop.last %}<span class="indice-sep" aria-hidden="true">·</span>{% endif %}
            {% endfor %}
          </dd>
        </div>
        {% endfor %}
      </dl>
    </details>
  </section>

  {# ── LUOGHI ── #}
  <section class="indice-section" id="luoghi">
    <details class="indice-details">
      <summary class="indice-section-title">Luoghi <span class="indice-chevron" aria-hidden="true">›</span></summary>
      <dl class="indice-list">
        {% for concept in luoghi %}
        <div class="indice-item{% if concept.articles.length > 1 %} indice-item--multi{% endif %}">
          <dt class="indice-term">
            <a href="/concetti/{{ concept.name | slugify }}/" class="indice-term-link{% if concept.lab %} indice-term-link--lab{% endif %}">{{ concept.name }}</a>{% if concept.lab %}<span class="indice-lab-badge" aria-label="Episteme Lab">lab</span>{% endif %}
            {% if concept.articles.length > 1 %}<span class="indice-count" aria-label="{{ concept.articles.length }} articoli">{{ concept.articles.length }}</span>{% endif %}
          </dt>
          <dd class="indice-articles">
            {% for art in concept.articles %}
            <a href="{{ art.url }}" class="indice-article-link{% if art._source == 'curated' %} indice-article-link--curated{% elif art._source == 'lab' %} indice-article-link--lab{% endif %}">{{ art.title }}{% if art._source == 'curated' %}<span class="indice-curated-badge" aria-label="curated">c</span>{% elif art._source == 'lab' %}<span class="indice-lab-badge" aria-label="lab">lab</span>{% endif %}</a>{% if not loop.last %}<span class="indice-sep" aria-hidden="true">·</span>{% endif %}
            {% endfor %}
          </dd>
        </div>
        {% endfor %}
      </dl>
    </details>
  </section>

  {# ── ISTITUZIONI ── #}
  <section class="indice-section" id="istituzioni">
    <details class="indice-details">
      <summary class="indice-section-title">Istituzioni <span class="indice-chevron" aria-hidden="true">›</span></summary>
      <dl class="indice-list">
        {% for concept in istituzioni %}
        <div class="indice-item{% if concept.articles.length > 1 %} indice-item--multi{% endif %}">
          <dt class="indice-term">
            <a href="/concetti/{{ concept.name | slugify }}/" class="indice-term-link{% if concept.lab %} indice-term-link--lab{% endif %}">{{ concept.name }}</a>{% if concept.lab %}<span class="indice-lab-badge" aria-label="Episteme Lab">lab</span>{% endif %}
            {% if concept.articles.length > 1 %}<span class="indice-count" aria-label="{{ concept.articles.length }} articoli">{{ concept.articles.length }}</span>{% endif %}
          </dt>
          <dd class="indice-articles">
            {% for art in concept.articles %}
            <a href="{{ art.url }}" class="indice-article-link{% if art._source == 'curated' %} indice-article-link--curated{% elif art._source == 'lab' %} indice-article-link--lab{% endif %}">{{ art.title }}{% if art._source == 'curated' %}<span class="indice-curated-badge" aria-label="curated">c</span>{% elif art._source == 'lab' %}<span class="indice-lab-badge" aria-label="lab">lab</span>{% endif %}</a>{% if not loop.last %}<span class="indice-sep" aria-hidden="true">·</span>{% endif %}
            {% endfor %}
          </dd>
