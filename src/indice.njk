---
layout: layouts/base.njk
title: "Indice"
description: "Indice analitico del sito: persone, teorie, paesi, luoghi, istituzioni e testi citati negli articoli."
permalink: "/indice/"
---

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Indice analitico",
  "description": "Indice analitico di claudiocammarano.com: persone, teorie, paesi e testi citati negli articoli.",
  "url": "https://claudiocammarano.com/indice/",
  "author": {
    "@type": "Person",
    "name": "Claudio Cammarano",
    "url": "https://claudiocammarano.com/about/"
  }
}
</script>

{% set personas    = collections.mergedConceptsIndex | filterByType("persona") %}
{% set teorie      = collections.mergedConceptsIndex | filterByType("teoria") %}
{% set paesi       = collections.mergedConceptsIndex | filterByType("paese") %}
{% set luoghi      = collections.mergedConceptsIndex | filterByType("luogo") %}
{% set istituzioni = collections.mergedConceptsIndex | filterByType("istituzione") %}
{% set testi       = collections.mergedConceptsIndex | filterByType("testo") %}

<div class="indice-page">

  <header class="temi-page-header">
    <p class="tag-page-label">Indice analitico</p>
    <h1 class="temi-page-title">Indice</h1>
    <p class="temi-page-intro">Il sito si naviga su tre livelli, dal più ampio al più specifico: <strong>Temi</strong> (4 cluster), <strong>Argomenti</strong> (i tag sopra ogni articolo, 20) e <strong>Concetti</strong> (persone, teorie, paesi, luoghi, istituzioni e testi citati, sotto). Questo indice li raccoglie tutti, così è chiaro su quale livello ci si trova in ogni momento.</p>
    <nav class="indice-jump-nav" aria-label="Salta a sezione">
      <a href="#temi">Temi</a>
      <a href="#argomenti">Argomenti</a>
      <a href="#persone">Persone</a>
      <a href="#teorie">Teorie</a>
      <a href="#paesi">Paesi</a>
      <a href="#luoghi">Luoghi</a>
      <a href="#istituzioni">Istituzioni</a>
      <a href="#testi">Testi</a>
    </nav>
  </header>

  {# ── TEMI ── #}
  <section class="indice-section" id="temi">
    <details class="indice-details">
      <summary class="indice-section-title">Temi <span class="indice-chevron" aria-hidden="true">›</span></summary>
      <p class="indice-section-note">Il livello più ampio: 4 cluster che raggruppano gli argomenti per affinità. <a href="/temi/">Vedi la pagina Temi →</a></p>
      <dl class="indice-list">
        {% for clusterName, clusterTags in clusters %}
        <div class="indice-item">
          <dt class="indice-term">
            <a href="/temi/#{{ clusterName | slugify }}" class="indice-term-link">{{ clusterName }}</a>
          </dt>
          <dd class="indice-articles">{% if temiDescriptions[clusterName] %}{{ temiDescriptions[clusterName] }}{% endif %}</dd>
        </div>
        {% endfor %}
      </dl>
    </details>
  </section>

  {# ── ARGOMENTI ── #}
  <section class="indice-section" id="argomenti">
    <details class="indice-details">
      <summary class="indice-section-title">Argomenti <span class="indice-chevron" aria-hidden="true">›</span></summary>
      <p class="indice-section-note">Il livello intermedio: i tag sopra ogni articolo, più specifici dei temi e più ampi dei concetti. Raggruppati per tema di appartenenza.</p>
      {% for clusterName, clusterTags in clusters %}
      <p class="indice-subgroup-title">{{ clusterName }}</p>
      <dl class="indice-list indice-list--subgroup">
        {% for tag in clusterTags %}
        {% set tagPosts = collections.writings | filterByTag(tag) %}
        <div class="indice-item{% if tagPosts.length > 1 %} indice-item--multi{% endif %}">
          <dt class="indice-term">
            <a href="/tag/{{ tag | slugify }}/" class="indice-term-link">{{ tag }}</a>
            {% if tagPosts.length %}<span class="indice-count" aria-label="{{ tagPosts.length }} articoli">{{ tagPosts.length }}</span>{% endif %}
          </dt>
          <dd class="indice-articles">{% if tagDescriptions[tag] %}{{ tagDescriptions[tag] }}{% endif %}</dd>
        </div>
        {% endfor %}
      </dl>
      {% endfor %}
    </details>
  </section>

  {# ── PERSONE ── #}
  <section class="indice-section" id="persone">
    <details class="indice-details">
      <summary class="indice-section-title">Persone <span class="indice-chevron" aria-hidden="true">›</span></summary>
      <dl class="indice-list">
        {% for concept in personas %}
        <div class="indice-item{% if concept.articles.length > 1 %} indice-item--multi{% endif %}">
          <dt class="indice-term">
            <a href="/concetti/{{ concept.name | slugify }}/" class="indice-term-link">{{ concept.name }}</a>
            {% if concept.articles.length > 1 %}<span class="indice-count" aria-label="{{ concept.articles.length }} articoli">{{ concept.articles.length }}</span>{% endif %}
          </dt>
          <dd class="indice-articles">
            {% for art in concept.articles %}
            <a href="{{ art.url }}" class="indice-article-link{% if art._source == 'curated' %} indice-article-link--curated{% endif %}">{{ art.title }}{% if art._source == 'curated' %}<span class="indice-curated-badge" aria-label="curated">c</span>{% endif %}</a>{% if not loop.last %}<span class="indice-sep" aria-hidden="true">·</span>{% endif %}
            {% endfor %}
          </dd>
        </div>
        {% endfor %}
      </dl>
    </details>
  </section>

  {# ── TEORIE ── #}
  <section class="indice-section" id="teorie">
    <details class="indice-details">
      <summary class="indice-section-title">Teorie e concetti <span class="indice-chevron" aria-hidden="true">›</span></summary>
      <dl class="indice-list">
        {% for concept in teorie %}
        <div class="indice-item{% if concept.articles.length > 1 %} indice-item--multi{% endif %}">
          <dt class="indice-term">
            <a href="/concetti/{{ concept.name | slugify }}/" class="indice-term-link">{{ concept.name }}</a>
            {% if concept.articles.length > 1 %}<span class="indice-count" aria-label="{{ concept.articles.length }} articoli">{{ concept.articles.length }}</span>{% endif %}
          </dt>
          <dd class="indice-articles">
            {% for art in concept.articles %}
            <a href="{{ art.url }}" class="indice-article-link{% if art._source == 'curated' %} indice-article-link--curated{% endif %}">{{ art.title }}{% if art._source == 'curated' %}<span class="indice-curated-badge" aria-label="curated">c</span>{% endif %}</a>{% if not loop.last %}<span class="indice-sep" aria-hidden="true">·</span>{% endif %}
            {% endfor %}
          </dd>
        </div>
        {% endfor %}
      </dl>
    </details>
  </section>

  {# ── PAESI ── #}
  <section class="indice-section" id="paesi">
    <details class="indice-details">
      <summary class="indice-section-title">Paesi <span class="indice-chevron" aria-hidden="true">›</span></summary>
      <dl class="indice-list">
        {% for concept in paesi %}
        <div class="indice-item{% if concept.articles.length > 1 %} indice-item--multi{% endif %}">
          <dt class="indice-term">
            <a href="/concetti/{{ concept.name | slugify }}/" class="indice-term-link">{{ concept.name }}</a>
            {% if concept.articles.length > 1 %}<span class="indice-count" aria-label="{{ concept.articles.length }} articoli">{{ concept.articles.length }}</span>{% endif %}
          </dt>
          <dd class="indice-articles">
            {% for art in concept.articles %}
            <a href="{{ art.url }}" class="indice-article-link{% if art._source == 'curated' %} indice-article-link--curated{% endif %}">{{ art.title }}{% if art._source == 'curated' %}<span class="indice-curated-badge" aria-label="curated">c</span>{% endif %}</a>{% if not loop.last %}<span class="indice-sep" aria-hidden="true">·</span>{% endif %}
            {% endfor %}
          </dd>
        </div>
        {% endfor %}
      </dl>
    </details>
  </section>

  {# ── LUOGHI ── #}
  <section class="indice-section" id="luoghi">
    <details class="indice-details">
      <summary class="indice-section-title">Luoghi <span class="indice-chevron" aria-hidden="true">›</span></summary>
      <dl class="indice-list">
        {% for concept in luoghi %}
        <div class="indice-item{% if concept.articles.length > 1 %} indice-item--multi{% endif %}">
          <dt class="indice-term">
            <a href="/concetti/{{ concept.name | slugify }}/" class="indice-term-link">{{ concept.name }}</a>
            {% if concept.articles.length > 1 %}<span class="indice-count" aria-label="{{ concept.articles.length }} articoli">{{ concept.articles.length }}</span>{% endif %}
          </dt>
          <dd class="indice-articles">
            {% for art in concept.articles %}
            <a href="{{ art.url }}" class="indice-article-link{% if art._source == 'curated' %} indice-article-link--curated{% endif %}">{{ art.title }}{% if art._source == 'curated' %}<span class="indice-curated-badge" aria-label="curated">c</span>{% endif %}</a>{% if not loop.last %}<span class="indice-sep" aria-hidden="true">·</span>{% endif %}
            {% endfor %}
          </dd>
        </div>
        {% endfor %}
      </dl>
    </details>
  </section>

  {# ── ISTITUZIONI ── #}
  <section class="indice-section" id="istituzioni">
    <details class="indice-details">
      <summary class="indice-section-title">Istituzioni <span class="indice-chevron" aria-hidden="true">›</span></summary>
      <dl class="indice-list">
        {% for concept in istituzioni %}
        <div class="indice-item{% if concept.articles.length > 1 %} indice-item--multi{% endif %}">
          <dt class="indice-term">
            <a href="/concetti/{{ concept.name | slugify }}/" class="indice-term-link">{{ concept.name }}</a>
            {% if concept.articles.length > 1 %}<span class="indice-count" aria-label="{{ concept.articles.length }} articoli">{{ concept.articles.length }}</span>{% endif %}
          </dt>
          <dd class="indice-articles">
            {% for art in concept.articles %}
            <a href="{{ art.url }}" class="indice-article-link{% if art._source == 'curated' %} indice-article-link--curated{% endif %}">{{ art.title }}{% if art._source == 'curated' %}<span class="indice-curated-badge" aria-label="curated">c</span>{% endif %}</a>{% if not loop.last %}<span class="indice-sep" aria-hidden="true">·</span>{% endif %}
            {% endfor %}
          </dd>
        </div>
        {% endfor %}
      </dl>
    </details>
  </section>

  {# ── TESTI ── #}
  <section class="indice-section" id="testi">
    <details class="indice-details">
      <summary class="indice-section-title">Testi <span class="indice-chevron" aria-hidden="true">›</span></summary>
      <dl class="indice-list">
        {% for concept in testi %}
        <div class="indice-item{% if concept.articles.length > 1 %} indice-item--multi{% endif %}">
          <dt class="indice-term indice-term--testo">
            <a href="/concetti/{{ concept.name | slugify }}/" class="indice-term-link">{{ concept.name }}</a>
            {% if concept.articles.length > 1 %}<span class="indice-count" aria-label="{{ concept.articles.length }} articoli">{{ concept.articles.length }}</span>{% endif %}
            {% if concept.citation %}<span class="indice-citation">{{ concept.citation | safe }}</span>{% endif %}
          </dt>
          <dd class="indice-articles">
            {% for art in concept.articles %}
            <a href="{{ art.url }}" class="indice-article-link{% if art._source == 'curated' %} indice-article-link--curated{% endif %}">{{ art.title }}{% if art._source == 'curated' %}<span class="indice-curated-badge" aria-label="curated">c</span>{% endif %}</a>{% if not loop.last %}<span class="indice-sep" aria-hidden="true">·</span>{% endif %}
            {% endfor %}
          </dd>
        </div>
        {% endfor %}
      </dl>
    </details>
  </section>

</div>

<script>
  (function() {
    function syncAccordion() {
      var isDesktop = window.matchMedia('(min-width: 601px)').matches;
      document.querySelectorAll('.indice-details').forEach(function(d) {
        d.open = isDesktop;
      });
    }
    syncAccordion();
    window.matchMedia('(min-width: 601px)').addEventListener('change', syncAccordion);
  })();
</script>
