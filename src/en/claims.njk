{# ===================================================================
   /en/claims/ — il muro delle lessie e la mappa dei concetti.
   Dati: src/_data/claims.js (le lessie) e src/_data/claimLayers.js (i
   cinque strati, piu' il layout del diagramma ad archi, calcolato a
   build time). Questa pagina non fa matematica e non carica librerie.
   Tre stati per unita': chiusa, passaggio aperto, tagli in vista.
   Senza JavaScript: contesto e tagli visibili, filtri nascosti.
   =================================================================== #}

{% set gloss = {
  "riferimento-tecnico": "technical reference",
  "dato-che-corregge": "corrective datum",
  "metodo-di-lavoro": "working method",
  "strumento-concettuale": "conceptual tool",
  "lettura-di-mercato": "market reading",
  "elementi-di-scenario": "scenario element"
} %}
{% set G = claimLayers.graph %}

<style>
.cl-intro{max-width:34em}
.cl-rules{margin:2.2em 0;padding-left:1.2em;border-left:4px solid var(--color-primary);max-width:34em}
.cl-rules p{margin:.5em 0;font-size:.95em}

/* --- i cinque strati ------------------------------------------------ */
.cl-layers{list-style:none;margin:2.4em 0;padding:0;max-width:38em}
.cl-layers li{padding:.8em 0 .8em 1.2em;border-left:4px solid var(--color-border);margin-bottom:.2em}
.cl-layers li.on{border-left-color:var(--color-primary)}
.cl-ly-n{font-family:Georgia,serif;font-size:1.12rem}
.cl-ly-n b{font-weight:400;color:var(--color-text-light);font-size:.8rem;margin-left:.5em}
.cl-ly-r{display:block;font-size:.72em;letter-spacing:.05em;text-transform:uppercase;color:var(--color-text-light);margin:.35em 0 .3em}
.cl-ly-r i{font-style:normal}
.cl-ly-r i+i:before{content:" \00b7 "}
.cl-ly-d{font-size:.92em;color:var(--color-text-light);margin:0}

/* --- la mappa dei concetti ------------------------------------------ */
.cm{margin:1em 0 2.4em;padding:0}
.cm svg{width:100%;max-width:560px;height:auto;display:block;overflow:visible}
.cm-arcs path{fill:none;stroke:var(--color-border);stroke-width:1}
.cm-band{font-size:10px;letter-spacing:.1em;text-transform:uppercase;fill:#800020;stroke:#fff;stroke-width:3px;paint-order:stroke fill}
.cm-n circle{fill:#fff;stroke:var(--color-primary);stroke-width:1.6}
.cm-lab{font-family:Georgia,serif;font-size:14px;fill:var(--color-text)}
.cm-num{font-size:11px;fill:var(--color-text-light);letter-spacing:.06em}
.cm-bar{fill:var(--color-primary);opacity:.35}
.cm-hit{fill:transparent;cursor:pointer}
.cm-n:hover circle,.cm-n:focus circle{fill:var(--color-primary)}
.cm-n:focus{outline:none}
.cm-n:focus .cm-lab{text-decoration:underline}
.cm.sel .cm-n{opacity:.3}
.cm.sel .cm-n.on{opacity:1}
.cm.sel .cm-n.on circle{fill:var(--color-primary)}
.cm.sel .cm-arcs path{opacity:.25}
.cm.sel .cm-arcs path.on{opacity:1;stroke:#800020;stroke-width:1.6}
.cm-note{font-family:Georgia,serif;font-size:1.02rem;line-height:1.55;color:var(--color-text-light);margin:.6em 0 0;max-width:34em;min-height:3.1em}
.cm-note b{color:var(--color-text);font-weight:600}

.cl-strip{font-size:.78em;letter-spacing:.06em;text-transform:uppercase;color:var(--color-text-light);margin:2.6em 0 .7em}
.cl-filters{display:flex;flex-wrap:wrap;gap:.4em;margin:0 0 2.6em;padding:0;list-style:none}
.cl-chip{font:inherit;font-size:.74em;letter-spacing:.05em;text-transform:uppercase;background:none;border:1px solid var(--color-border);color:var(--color-text-light);padding:.45em .8em;cursor:pointer;min-height:34px}
.cl-chip[aria-pressed="true"]{background:var(--color-primary);border-color:var(--color-primary);color:#fff}
.cl-chip b{font-weight:400;opacity:.65;margin-left:.4em}

/* --- l'unita' -------------------------------------------------------- */
.lx{border-left:4px solid var(--color-border);padding-left:1.4em;margin:0 0 3.4em;transition:border-color .15s}
.lx:hover,.lx.is-open{border-left-color:var(--color-primary)}
.lx-head{font-size:.78em;letter-spacing:.04em;color:var(--color-text-light);margin:0 0 .8em}
.lx-cite{font-style:normal;font-weight:600;color:var(--color-text)}
.lx-cite a{color:inherit;text-decoration:none;border-bottom:1px solid var(--color-border)}
.lx-locus:before{content:"\00a0\00b7\00a0"}
.lx-ctx{font-family:Georgia,serif;font-size:1.05rem;line-height:1.65;color:#8f8f8f;margin:0;max-height:1.65em;overflow:hidden}
.lx-before{-webkit-mask-image:linear-gradient(to bottom,transparent,#000);mask-image:linear-gradient(to bottom,transparent,#000)}
.lx-after{-webkit-mask-image:linear-gradient(to top,transparent,#000);mask-image:linear-gradient(to top,transparent,#000)}
.lx.is-open .lx-ctx{max-height:40em;color:#6e6e6e;-webkit-mask-image:none;mask-image:none}
