.lx-claim:before,.lx-claim:after{content:none}
.lx-cut{display:none;color:#800020}
.lx.is-cuts .lx-cut{display:inline}
.lx.is-cuts .lx-ell{display:none}
.lx-layers{margin:1em 0 0;font-size:.8em;color:var(--color-text-light)}
.lx-layers a{color:var(--color-primary);text-decoration:none;border-bottom:1px solid var(--color-border)}
.lx-layers .k{font-size:.86em;letter-spacing:.07em;text-transform:uppercase;color:#aaa}
.lx-foot{display:flex;flex-wrap:wrap;align-items:center;gap:.5em;margin-top:.8em;font-size:.74em;letter-spacing:.05em;text-transform:uppercase}
.lx-fn{background:var(--color-primary);color:#fff;padding:.32em .62em}
.lx-d1,.lx-stance,.lx-w{color:var(--color-text-light)}
.lx-d1 abbr{text-decoration:none;cursor:help;color:var(--color-primary)}
.lx-stance-contested{color:#800020;font-weight:600}
.lx-w:before{content:"weight "}
.lx-btn{font:inherit;font-size:1em;letter-spacing:.05em;text-transform:uppercase;background:none;border:1px solid var(--color-border);color:var(--color-text-light);padding:.4em .7em;cursor:pointer;min-height:34px}
.lx-btn[aria-expanded="true"]{border-color:var(--color-primary);color:var(--color-primary)}
.lx-rel{list-style:none;margin:1em 0 0;padding:0;font-size:.86em;color:var(--color-text-light);max-width:38em}
.lx-rel li{margin:.3em 0}
.lx-rel em{font-style:normal;font-size:.8em;letter-spacing:.06em;text-transform:uppercase;color:#800020}
.lx-rel a{color:var(--color-primary)}
.cl-empty{font-family:Georgia,serif;color:var(--color-text-light);display:none}
