---
pagination:
  data: collections.mergedConceptsIndex
  size: 1
  alias: concept
permalink: "/concetti/{{ concept.name | slugify }}/"
layout: layouts/base.njk
eleventyComputed:
  title: "{{ concept.name | displayName(concept.type) | safe }}"
  description: "{% if concept.note %}{{ concept.note | stripMd | truncate(155) | safe }}{% else %}Articoli collegati a {{ concept.name | displayName(concept.type) | safe }} — indice concettuale di claudiocammarano.com{% endif %}"
---

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "{{ concept.name | displayName(concept.type) | jsonEscape | safe }}",
  "description": "Articoli collegati a {{ concept.name | displayName(concept.type) | jsonEscape | safe }}",
  "url": "https://claudiocammarano.com{{ page.url }}",
  "author": {
    "@type": "Person",
    "@id": "https://claudiocammarano.com/#person",
    "name": "Claudio Cammarano",
    "url": "https://claudiocammarano.com"
  }
}
</script>

<div class="concetto-page">

  {# ── Header ── #}
  <header class="tag-page-header">
    <nav class="breadcrumb" aria-label="Navigazione">
      <a href="/">Home</a>
      <span class="breadcrumb-sep" aria-hidden="true">·</span>
      {% if concept.type == "persona" %}
        <a href="/indice/#persone">Persone</a>
      {% elif concept.type == "teoria" %}
        <a href="/indice/#teorie">Teorie</a>
      {% elif concept.type == "testo" %}
        <a href="/indice/#testi">Testi</a>
      {% elif concept.type == "istituzione" %}
        <a href="/indice/#istituzioni">Istituzioni</a>
      {% elif concept.type == "luogo" %}
        <a href="/indice/#luoghi">Luoghi</a>
      {% elif concept.type == "paese" %}
        <a href="/indice/#paesi">Paesi</a>
      {% else %}
        <a href="/indice/">Indice</a>
      {% endif %}
      <span class="breadcrumb-sep" aria-hidden="true">·</span>
      <span class="breadcrumb-current">{{ concept.name | displayName(concept.type) }}</span>
    </nav>
    {% if concept.type %}
    <p class="concetto-type-badge">{{ concept.type }}</p>
    {% endif %}
    <h1 class="tag-page-title">{{ concept.name | displayName(concept.type) }}</h1>
    <p class="tag-page-count">
      {% if concept.articles.length == 0 %}Nessun articolo ancora
      {% elif concept.articles.length == 1 %}1 articolo
      {% else %}{{ concept.articles.length }} articoli{% endif %}
    </p>
    {% if concept.type == "testo" and concept.citation %}
    <p class="concetto-citation">{{ concept.citation | safe }}</p>
    {% endif %}
    {% if concept.note %}
    <p class="tag-page-intro">{{ concept.note | mdInline | safe }}</p>
    {% endif %}
  </header>

  {# ── Concetti vicini (chip row) ── #}
  {% set related = concept.name | relatedConcepts(collections.mergedConceptsIndex) %}
  {% if related.length %}
  <section class="concetto-related" aria-label="Concetti collegati">
    <p class="concetto-related-label">Concetti vicini</p>
    <div class="concetto-chips">
      {% for r in related %}
      <a href="/concetti/{{ r.name | slugify }}/" class="concetto-chip" title="{{ r.sharedCount }} {% if r.sharedCount == 1 %}articolo in comune{% else %}articoli in comune{% endif %}">{{ r.name | displayName }}</a>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {# ── Vicinato nella mappa: stesso disegno della pagina /mappa/, ritagliato
        su questo concetto. Le coordinate sono quelle della mappa grande
        trasformate per similitudine, quindi la posizione angolare di un
        termine e' la stessa qui e la'. Vedi src/js/heb.js. ── #}
  {% if concept.articles.length > 0 %}
  <section class="concetto-heb heb is-loading" id="heb-card" aria-label="Vicinato di {{ concept.name | displayName(concept.type) }} nella mappa dei concetti">
    <div class="concetto-heb-head">
      <span class="concetto-heb-title">Nel resto della mappa</span>
      <a class="concetto-heb-link" href="/mappa/?focus={{ concept.name | slugify }}">Vedi la mappa completa &#8594;</a>
    </div>
    <div class="heb-box" data-heb-box>
      <canvas></canvas>
      <svg viewBox="0 0 480 480" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Anello dei concetti del sito con evidenziati i legami di {{ concept.name | displayName(concept.type) }}"></svg>
    </div>
    <p class="concetto-heb-note" data-heb-note></p>
  </section>
  {% endif %}

  {# ── Lista articoli ── #}
  {% if concept.articles.length > 0 %}
  <div class="concetto-articles">
    {% for a in concept.articles %}
    <article class="concetto-article-item">
      <h2 class="concetto-article-title">
        <a href="{{ a.url }}">{{ a.title }}</a>
      </h2>
      <p class="concetto-article-meta">
        {% if a.url.startsWith('/writings/') %}Saggio
        {% elif a.url.startsWith('/curated/') %}Curato
        {% elif a.url.startsWith('/learning/') %}Apprendimento
        {% else %}Articolo{% endif %}
      </p>
    </article>
    {% endfor %}
  </div>
  {% endif %}

</div>

<script src="/js/heb.js" defer></script>
<script>
  window.addEventListener('DOMContentLoaded', function () {
    if (window.HEB) window.HEB.mount('#heb-card', 'card', '{{ concept.name | slugify }}');
  });
</script>
