---
pagination:
  data: collections.mergedConceptsIndex
  size: 1
  alias: concept
permalink: "/concetti/{{ concept.name | slugify }}/"
layout: layouts/base.njk
eleventyComputed:
  title: "{{ concept.name }}"
  description: "Articoli collegati a {{ concept.name }} — indice concettuale di claudiocammarano.com"
---

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "{{ concept.name | jsonEscape | safe }}",
  "description": "Articoli collegati a {{ concept.name | jsonEscape | safe }}",
  "url": "https://claudiocammarano.com{{ page.url }}",
  "author": {
    "@type": "Person",
    "name": "Claudio Cammarano",
    "url": "https://claudiocammarano.com/about/"
  }
}
</script>

<div class="concetto-page">

  {# ── Header ── #}
  <header class="tag-page-header">
    <nav class="breadcrumb" aria-label="Navigazione">
      <a href="/">Home</a>
      <span class="breadcrumb-sep" aria-hidden="true">·</span>
      {% if concept.type == "persona" %}
        <a href="/indice/#persone">Persone</a>
      {% elif concept.type == "teoria" %}
        <a href="/indice/#teorie">Teorie</a>
      {% elif concept.type == "testo" %}
        <a href="/indice/#testi">Testi</a>
      {% elif concept.type == "istituzione" %}
        <a href="/indice/#istituzioni">Istituzioni</a>
      {% elif concept.type == "luogo" %}
        <a href="/indice/#luoghi">Luoghi</a>
      {% elif concept.type == "paese" %}
        <a href="/indice/#paesi">Paesi</a>
      {% else %}
        <a href="/indice/">Indice</a>
      {% endif %}
      <span class="breadcrumb-sep" aria-hidden="true">·</span>
      <span class="breadcrumb-current">{{ concept.name }}</span>
    </nav>
    {% if concept.type %}
    <p class="concetto-type-badge">{{ concept.type }}</p>
    {% endif %}
    <h1 class="tag-page-title">{{ concept.name }}</h1>
    <p class="tag-page-count">
      {% if concept.articles.length == 0 %}Nessun articolo ancora
      {% elif concept.articles.length == 1 %}1 articolo
      {% else %}{{ concept.articles.length }} articoli{% endif %}
    </p>
    {% if concept.type == "testo" and concept.citation %}
    <p class="concetto-citation">{{ concept.citation | safe }}</p>
    {% endif %}
    {% if concept.note %}
    <p class="tag-page-intro">{{ concept.note }}</p>
    {% endif %}
  </header>

  {# ── Concetti vicini (chip row) ── #}
  {% set related = concept.name | relatedConcepts(collections.mergedConceptsIndex) %}
  {% if related.length %}
  <section class="concetto-related" aria-label="Concetti collegati">
    <p class="concetto-related-label">Concetti vicini</p>
    <div class="concetto-chips">
      {% for r in related %}
      <a href="/concetti/{{ r.name | slugify }}/" class="concetto-chip" title="{{ r.sharedCount }} {% if r.sharedCount == 1 %}articolo in comune{% else %}articoli in comune{% endif %}">{{ r.name }}</a>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {# ── Finestra sul grafo globale (desktop ≥900px, solo se ci sono articoli) ── #}
  {% if concept.articles.length > 0 %}
  <div class="concetto-graph-wrap" id="concept-graph-wrap" data-slug="{{ concept.name | slugify }}" aria-hidden="true">
    <svg id="concept-graph-svg"></svg>
    <div class="concetto-graph-minimap" id="concept-minimap" aria-hidden="true">
      <svg id="concept-minimap-svg"></svg>
    </div>
    <a href="/mappa/?focus={{ concept.name | slugify }}" class="concetto-graph-fullmap-link">Vedi mappa completa →</a>
  </div>
  {% endif %}

  {# ── Lista articoli ── #}
  {% if concept.articles.length > 0 %}
  <div class="concetto-articles">
    {% for a in concept.articles %}
    <article class="concetto-article-item">
      <h2 class="concetto-article-title">
        <a href="{{ a.url }}">{{ a.title }}</a>
      </h2>
      <p class="concetto-article-meta">
        {% if a.url.startsWith('/writings/') %}Saggio
        {% elif a.url.startsWith('/curated/') %}Curato
        {% elif a.url.startsWith('/learning/') %}Apprendimento
        {% else %}Articolo{% endif %}
      </p>
    </article>
    {% endfor %}
  </div>
  {% endif %}

</div>

{# ── Finestra sul grafo globale — vanilla JS, nessuna libreria esterna, solo desktop ── #}
<script>
(function () {
  var wrap = document.getElementById('concept-graph-wrap');
  if (!wrap || window.innerWidth < 900) return;

  var focusSlug = wrap.getAttribute('data-slug');
  if (!focusSlug) return;

  var NS = 'http://www.w3.org/2000/svg';
  function el(tag, attrs) {
    var e = document.createElementNS(NS, tag);
    for (var k in attrs) e.setAttribute(k, attrs[k]);
    return e;
  }

  fetch('/graph-data.json')
    .then(function (r) { return r.json(); })
    .then(function (graph) { buildWindow(graph); })
    .catch(function () {});

  function clusterColors(cs) {
    return {
      'Epistemologia & AI':       cs.getPropertyValue('--graph-cluster-epi').trim()  || '#1C0E80',
      'Geopolitica & potere':     cs.getPropertyValue('--graph-cluster-geo').trim()  || '#185FA5',
      'Editoria & comunicazione': cs.getPropertyValue('--graph-cluster-edi').trim()  || '#0F6E56',
      'Italia & istituzioni':     cs.getPropertyValue('--graph-cluster-ita').trim()  || '#8B5E1F',
      'Economia & lavoro':        cs.getPropertyValue('--graph-cluster-eco').trim()  || '#A13D3D'
    };
  }

  function buildWindow(graph) {
    var nodes = graph.nodes, edges = graph.edges;
    var byIndex = {};
    nodes.forEach(function (n) { byIndex[n.i] = n; });
    var focus = nodes.filter(function (n) { return n.slug === focusSlug; })[0];
    if (!focus) return;

    var neighborEdges = edges.filter(function (e) { return e.source === focus.i || e.target === focus.i; });
    neighborEdges.sort(function (a, b) { return b.weight - a.weight; });
    var neighbors = neighborEdges.slice(0, 8).map(function (e) {
      return byIndex[e.source === focus.i ? e.target : e.source];
    }).filter(Boolean);
    var neighborIdx = {};
    neighbors.forEach(function (n) { neighborIdx[n.i] = true; });

    var pts = [focus].concat(neighbors);
    var minX = Math.min.apply(null, pts.map(function (p) { return p.x; }));
    var maxX = Math.max.apply(null, pts.map(function (p) { return p.x; }));
    var minY = Math.min.apply(null, pts.map(function (p) { return p.y; }));
    var maxY = Math.max.apply(null, pts.map(function (p) { return p.y; }));

    minX -= 70; maxX += 70; minY -= 50; maxY += 60;

    var w = maxX - minX, h = maxY - minY;
    var minW = 420, minH = 280;
    if (w < minW) { var dx = (minW - w) / 2; minX -= dx; maxX += dx; w = minW; }
    if (h < minH) { var dy = (minH - h) / 2; minY -= dy; maxY += dy; h = minH; }

    var svgEl = document.getElementById('concept-graph-svg');
    svgEl.setAttribute('viewBox', minX + ' ' + minY + ' ' + w + ' ' + h);
    svgEl.innerHTML = '';

    var cs = getComputedStyle(document.documentElement);
    var colorPrimary = cs.getPropertyValue('--color-primary').trim() || '#1C0E80';
    var colorBorder = cs.getPropertyValue('--color-border').trim() || '#e0e0e0';
    var colorHint = cs.getPropertyValue('--color-text-hint').trim() || '#999';
    var colorBg = cs.getPropertyValue('--color-bg').trim() || '#fff';
    var clusters = clusterColors(cs);
    function colorOf(n) { return clusters[n.cluster] || colorHint; }

    // Nodi di contesto: appartengono al riquadro per posizione, ma non sono vicini diretti
    var visible = nodes.filter(function (n) {
      return n.x >= minX && n.x <= maxX && n.y >= minY && n.y <= maxY &&
             n.i !== focus.i && !neighborIdx[n.i];
    });

    var shownIdx = {};
    shownIdx[focus.i] = true;
    neighbors.forEach(function (n) { shownIdx[n.i] = true; });
    visible.forEach(function (n) { shownIdx[n.i] = true; });
    var shownEdges = edges.filter(function (e) { return shownIdx[e.source] && shownIdx[e.target]; });

    var gEdges = el('g', {});
    shownEdges.forEach(function (e) {
      var s = byIndex[e.source], t = byIndex[e.target];
      var isFocusEdge = (e.source === focus.i || e.target === focus.i);
      gEdges.appendChild(el('line', {
        x1: s.x, y1: s.y, x2: t.x, y2: t.y,
        stroke: colorBorder,
        'stroke-width': isFocusEdge ? '1.2' : '0.6',
        opacity: isFocusEdge ? '0.7' : '0.35'
      }));
    });
    svgEl.appendChild(gEdges);

    var gContext = el('g', { opacity: '0.4' });
    visible.forEach(function (n) {
      gContext.appendChild(el('circle', { cx: n.x, cy: n.y, r: '4', fill: colorHint, stroke: colorBg, 'stroke-width': '1' }));
    });
    svgEl.appendChild(gContext);

    // I primi 3 vicini (i più forti, neighbors è già ordinato per peso) hanno
    // etichetta scritta sempre visibile; gli altri solo un tooltip al mouse-over.
    var VISIBLE_LABELS = 3;
    neighbors.forEach(function (n, idx) {
      var g = el('g', { cursor: 'pointer' });
      g.appendChild(el('circle', { cx: n.x, cy: n.y, r: '9', fill: colorOf(n), stroke: colorBg, 'stroke-width': '1.5' }));
      if (idx < VISIBLE_LABELS) {
        var label = el('text', {
          x: n.x, y: n.y + 21, 'text-anchor': 'middle',
          'font-family': 'var(--font-serif)', 'font-size': '11px', fill: colorHint
        });
        label.textContent = n.name;
        g.appendChild(label);
      } else {
        var title = el('title', {});
        title.textContent = n.name;
        g.appendChild(title);
      }
      g.addEventListener('click', function () { window.location.href = '/concetti/' + n.slug + '/'; });
      svgEl.appendChild(g);
    });

    var gFocus = el('g', {});
    gFocus.appendChild(el('circle', { cx: focus.x, cy: focus.y, r: '26', fill: colorPrimary, stroke: colorBg, 'stroke-width': '2' }));
    var words = focus.name.split(', ');
    var ty = words.length > 1 ? focus.y - 6 : focus.y;
    words.slice(0, 2).forEach(function (word, i) {
      gFocus.appendChild(el('text', {
        x: focus.x, y: ty + i * 15, 'text-anchor': 'middle', 'dominant-baseline': 'middle',
        'font-family': 'var(--font-serif)', 'font-size': '11px', 'font-weight': '500', fill: '#fff'
      })).textContent = word;
    });
    svgEl.appendChild(gFocus);

    buildMinimap(graph, focus, minX, minY, w, h, clusters, colorHint, colorPrimary);
  }

  function buildMinimap(graph, focus, vx, vy, vw, vh, clusters, colorHint, colorPrimary) {
    var mmSvg = document.getElementById('concept-minimap-svg');
    if (!mmSvg) return;
    mmSvg.setAttribute('viewBox', '0 0 ' + graph.width + ' ' + graph.height);
    mmSvg.innerHTML = '';
    graph.nodes.forEach(function (n) {
      mmSvg.appendChild(el('circle', {
        cx: n.x, cy: n.y, r: n.i === focus.i ? '7' : '3',
        fill: n.i === focus.i ? colorPrimary : (clusters[n.cluster] || colorHint),
        opacity: n.i === focus.i ? '1' : '0.7'
      }));
    });
    mmSvg.appendChild(el('rect', {
      x: vx, y: vy, width: vw, height: vh,
      fill: 'none', stroke: colorPrimary, 'stroke-width': '6', 'stroke-dasharray': '14 10', opacity: '0.85'
    }));
  }
}());
</script>
